to.tv/v2/stitch/hls/episode/6a9aea20da71d9a75fba0ec1/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=CA&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=45.4200&deviceLon=-75.7000&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=CA&serverSideAds=true&sessionID=1dc69d49-d503-11f1-b416-2600f46c7587&sid=1dc69d49-d503-11f1-b416-2600f46c7587&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..ZyRJBnhBFXVu4SlUFHPffnv0QscQ36uK74DGRsIBotM&masterJWTPassthrough=true"},"6a9aebf64996e40ab248c1d4-ca":{"_id":"6a9aebf64996e40ab248c1d4","seriesID":"6a9ae830ed186c2c8573765b","slug":"diamant-noir-2017-1-1","name":"Dark Inclusion","summary":"Pier (Niels Schneider), eager to avenge his banned father, returns to the family diamond business with an elaborate robbery in mind.","description":"Pier Ulmann (Niels Schneider) lives from hand-to-mouth in Paris, between construction work and petty theft that he commits on behalf of Rachid, his only “family.” But life catches up with him the day his father is found dead in the street after a long decline. The black sheep of a rich Antwerp family who deals in diamonds, he has left his son nothing, apart from the story of his banishment from the Ulmann family and a thirst for revenge. At his cousin Gabriel’s invitation, Pier goes to Antwerp to renovate the prestigious Ulmann family firm. Rachid ’s instructions are simple: “Go there at first to see; then to take.” But there are many facets to a diamond…","duration":8100000,"originalContentDuration":6930000,"allotment":8100,"rating":"14+","featuredImage":{"path":"https://images.pluto.tv/episodes/6a9aebf64996e40ab248c1d4/screenshot16_9_1788537942036.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Thriller","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6a9aebf64996e40ab248c1d4/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6a9aebf64996e40ab248c1d4/poster_1788537942036.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6a9aebf64996e40ab248c1d4/screenshot4_3_1788537942036.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6a9aebf64996e40ab248c1d4/screenshot16_9_1788537942036.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"64bff2ca24ade50008ba08a3"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6a9aebf64996e40ab248c1d4/poster16_9_1788537942036.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Niels Schneider","August Diehl","Hans Peter Cloos"],"directors":["Arthur Harari"],"originalReleaseDate":"2017-09-28T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6a9aebf64996e40ab248c1d4/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=CA&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=45.4200&deviceLon=-75.7000&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=CA&serverSideAds=true&sessionID=1dc69d49-d503-11f1-b416-2600f46c7587&sid=1dc69d49-d503-11f1-b416-2600f46c7587&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..ZyRJBnhBFXVu4SlUFHPffnv0QscQ36uK74DGRsIBotM&masterJWTPassthrough=true"},"6a9aea1cda71d9a75fb93803-ca":{"_id":"6a9aea1cda71d9a75fb93803","seriesID":"6a9aea1cda71d9a75fb937e6","slug":"mon-bebe-2019-1-1","name":"Sweetheart","summary":"When her youngest one is about to go to Canada to continue her education, Heloise, a working woman, mother of three, realizes that she's losing her most precious role, being a mother.","description":"Heloise is a mother of three. Her youngest daughter, Jade, has just turned eighteen and will soon be leaving the nest to pursue her studies in Canada. As Jade's departure approaches, Heloise reminisces of their shared past, a tight bond between mother and daughter. Dreading this seperation, Heloise takes on the role of a filmmaker and attempts, with her iPhone in hand, to capture their last moments together. Her urgent desire to film these fleeting moments consumes her to such a point that it prevents her from reaching the complicity and happiness she has always managed to share with her daughter, her \"baby\".","duration":6060000,"originalContentDuration":5130000,"allotment":6060,"rating":"G","featuredImage":{"path":"https://images.pluto.tv/episodes/6a9aea1cda71d9a75fb93803/screenshot16_9_1788537374448.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Comedy","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6a9aea1cda71d9a75fb93803/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6a9aea1cda71d9a75fb93803/poster_1788537374448.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6a9aea1cda71d9a75fb93803/screenshot4_3_1788537374448.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6a9aea1cda71d9a75fb93803/screenshot16_9_1788537374448.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"64bff2ca24ade50008ba08a3"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6a9aea1cda71d9a75fb93803/poster16_9_1788537374448.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Sandrine Kiberlain","Thaïs Alessandrin","Victor Belmondo","Patrick Chesnais","Yvan Attal","Kyan Khojandi","Arnaud Valois"],"directors":["Lisa Azuelos"],"