. but there is no need to worry when you're 20. Eternity lies ahead.","duration":5760000,"originalContentDuration":4815000,"allotment":5760,"rating":"14+","featuredImage":{"path":"https://images.pluto.tv/episodes/6a9ae65320b6387cd0ee490c/screenshot16_9_1788536404246.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Drama","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6a9ae65320b6387cd0ee490c/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6a9ae65320b6387cd0ee490c/poster_1788536404246.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6a9ae65320b6387cd0ee490c/screenshot4_3_1788536404246.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6a9ae65320b6387cd0ee490c/screenshot16_9_1788536404246.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"64bff2ca24ade50008ba08a3"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6a9ae65320b6387cd0ee490c/poster16_9_1788536404246.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Antoine Desrochers","Lea Jaouich","Sarah Mottet"],"directors":["Paul Barbeau"],"originalReleaseDate":"2026-04-16T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6a9ae65320b6387cd0ee490c/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=CA&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=45.4200&deviceLon=-75.7000&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=CA&serverSideAds=true&sessionID=1dc69d49-d503-11f1-b416-2600f46c7587&sid=1dc69d49-d503-11f1-b416-2600f46c7587&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMT