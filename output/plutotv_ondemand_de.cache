 gemeinsam mit ihren Familien. Für Sam ist aus der Freundschaft längst Liebe geworden, doch er hat nie den Mut gefunden, seine Gefühle zu gestehen. Als Kat ankündigt, die Stadt verlassen zu wollen, bleibt ihm nur noch ein Weihnachtsfest, um ihr zu zeigen, was sie ihm wirklich bedeutet.","duration":6069000,"originalContentDuration":5349000,"allotment":6069,"rating":"0","featuredImage":{"path":"https://images.pluto.tv/episodes/6accb3e278e140e3e4f82c3f/screenshot16_9_1791802249155.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Romance","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6accb3e278e140e3e4f82c3f/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6accb3e278e140e3e4f82c3f/poster_1791802249156.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6accb3e278e140e3e4f82c3f/screenshot4_3_1791802249155.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6accb3e278e140e3e4f82c3f/screenshot16_9_1791802249155.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5cd15239d9e0ec55c4ecc014"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6accb3e278e140e3e4f82c3f/poster16_9_1791802249156.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Danica McKellar","Dustin Milligan","Lea Thompson","Scott Patterson","Alexandra Paul","William F. Bryant","Cameron Goodman","Viva Bianca","Brian Huskey","Luc Charbonnier"],"directors":["Rachel Lee Goldenberg"],"producers":["David Michael Latt","David Rimawi","Paul Bales"],"originalReleaseDate":"2012-11-24T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6accb3e278e140e3e4f82c3f/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d