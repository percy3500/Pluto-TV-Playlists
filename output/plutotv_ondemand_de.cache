dern auch im Job, wo ihr gerade eine jüngere Kollegin als neue Chefin vorgesetzt wurde. Als Estelle vermutet, dass der Grund für ihre Lebenskrise sexueller Natur ist, verlässt sie ihre Komfortzone und versucht gemeinsam mit ihrem ebenso biederen Ehemann einen heißen Dreier auf die Beine zu stellen.","duration":6300000,"originalContentDuration":5475000,"allotment":6300,"rating":"12","featuredImage":{"path":"https://images.pluto.tv/episodes/620e12c4df454b001355138e/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Comedy","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/620e12c4df454b001355138e/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/620e12c4df454b001355138e/poster.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/620e12c4df454b001355138e/screenshot4_3.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/620e12c4df454b001355138e/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"60ec1639535a680007bcc6a6"},{"id":"6839884d5058e53f887b0683"},{"id":"648af7854c014a000826694f"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/620e12c4df454b001355138e/poster16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Mélissa Désormeaux-Poulin","Martin Matte","Romane Martins"],"directors":["Nicolas Monette"],"originalReleaseDate":"2018-11-23T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/620e12c4df454b001355138e/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceM