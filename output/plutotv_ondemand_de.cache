ten.","duration":5686000,"originalContentDuration":4966000,"allotment":5686,"rating":"12","featuredImage":{"path":"https://images.pluto.tv/episodes/6accc351b60195e27ed53dff/screenshot16_9_1791804242336.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Comedy","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6accc351b60195e27ed53dff/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6accc351b60195e27ed53dff/poster_1791804242336.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6accc351b60195e27ed53dff/screenshot4_3_1791804242336.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6accc351b60195e27ed53dff/screenshot16_9_1791804242336.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5cd15239d9e0ec55c4ecc014"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6accc351b60195e27ed53dff/poster16_9_1791804242336.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Attila","April Lerman","Kim Little","Alan Charof","Avalon Anders","Mark Stulce","Michael Xavier","Joe Mundi","Rae Latt"],"directors":["David Michael Latt"],"producers":["David Rimawi"],"originalReleaseDate":"1994-03-30T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6accc351b60195e27ed53dff/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=DE&serverSideAds=true&sessionID=42b2bf2d-d503-11f1-919e-e245b88e69f7&sid=42b2bf2d-d503-11f1-919e-e245b88e69f7&userId=&jwt=eyJhbGciOiJIUzI1N