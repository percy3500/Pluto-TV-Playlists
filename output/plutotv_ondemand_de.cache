on stirbt hinterlässt er seinem Sohn einen letzten Willen: Er wünscht, dass Jerry seinem alten Freund Jake Benson auf dessen Farm zur Hand geht. Durch eine glückliche Fügung stoßen die beiden auf eine Goldmine.","duration":3509000,"originalContentDuration":3149000,"allotment":3509,"rating":"12","featuredImage":{"path":"https://images.pluto.tv/episodes/68ecc969f1f80c8151c45542/screenshot16_9_1760353167421.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Western","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/68ecc969f1f80c8151c45542/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/68ecc969f1f80c8151c45542/poster_1760353166245.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/68ecc969f1f80c8151c45542/screenshot4_3_1760353168679.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/68ecc969f1f80c8151c45542/screenshot16_9_1760353167421.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"636a694e55d2e7000740d060"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/68ecc969f1f80c8151c45542/poster16_9_1760353170046.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["John Wayne","Barbara Sheldon","Llyod Whitlock","George Hayes","Yakoma Canutt"],"directors":["Robert N. Bradbury"],"originalReleaseDate":"1934-01-22T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/68ecc969f1f80c8151c45542/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=DE&