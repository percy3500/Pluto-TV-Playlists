categories":[{"id":"6093ef2da0ccef00072b7cf8"},{"id":"663a2a2563e82700137e30b5"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"actors":["Robert Lindsay"],"directors":["Kenny Scott"],"writers":["Kenny Scott"],"producers":["Rob Slater"],"originalReleaseDate":"2015-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6140586162aa05001450171e/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=DE&serverSideAds=true&sessionID=42b2bf2d-d503-11f1-919e-e245b88e69f7&sid=42b2bf2d-d503-11f1-919e-e245b88e69f7&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..aEAj3PS_Y3ldZRE81O56a4M491H_65zkm5gOYgnpVoU&masterJWTPassthrough=true"},"6140586462aa0500145017d9-de":{"_id":"6140586462aa0500145017d9","seriesID":"6140586262aa0500145017d3","slug":"the-catacomb-mystery-de-2012-1-1","name":"Die X-Gräber – Der unterirdische Friedhof von Rom","summary":"Tief unter den Straßen von Rom existiert eine erstaunliche Untergrundwelt: ein Labyrinth aus Tunneln und Gewölben mit einer Länge von mehr als 500 km. Dieser weitläufige unterirdische Friedhof wurde vor fast 2.000 Jahren von den alten Römern angelegt.","description":"Tief unter den Straßen von Rom existiert eine erstaunliche Untergrundwelt: ein Labyrinth aus Tunneln und Gewölben mit einer Länge von mehr als 500 km. Dieser weitläufige unterirdische Friedhof wurde vor fast 2.000 Jahren von den alten Römern angelegt.","duration":4020000,"originalContentDuration":3525000,"allotment":4020,"rating":"12","featuredImage":{"path":"https://images.pluto.tv/episodes/6140586462aa0500145017d9/screenshot16_9_1768022798017.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6140586462aa0500145017d9/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6140586462aa0500145017d9/poster_1768022798017.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6140586462aa0500145017d9/screenshot4_3_1768022798017.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6140586462aa0500145017d9/screenshot16_9_1768022798017.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6093ef2da0ccef00072b7cf8"},{"id":"663a2a2563e82700137e30b5"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"actors":["Michael Scott"],"directors":["Paul Olding"],"producers":["Paul Olding"],"originalReleaseDate":"2013-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6140586462aa0500145017d9/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=DE&serverSideAds=true&sessionID=42b2bf2d-d503-11f1-919e-e245b88e69f7&sid=42b2bf2d-d503-11f1-919e-e245b88e69f7&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..aEAj3PS_Y3ldZRE81O56a4M491H_65zkm5gOYgnpVoU&masterJWTPassthrough=true"},"6140585862aa050014501618-de":{"_id":"6140585862aa050014501618","seriesID":"6140585662aa050014501612","slug":"return-of-the-black-death-de-2013-1-1","name":"Das Jahr des Schwarzen Todes – Die Pestepidemie von London 1349","summary":"Die Mythen rund um die tödlichste Krankheit der westlichen Welt werden erschüttert. Jahrelang hatte man geglaubt, der Schwarze Tod, der im Mittelalter durch Europa fegte, sei die Beulenpest gewesen.","description":"Die Mythen rund um die tödlichste Krankheit der westlichen Welt werden erschüttert. Jahrelang hatte man geglaubt, der Schwarze Tod, der im Mittelalter durch Europa fegte, sei die Beulenpest gewesen.","duration":3240000,"originalContentDuration":2775000,"allotment":3240,"rating":"12","featuredImage":{"path":"https://images.pluto.tv/episodes/6140585862aa050014501618/screenshot16_9_1768002591268.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6140585862aa050014501618/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6140585862aa050014501618/poster_1768002591268.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6140585862aa050014501618/screenshot4_3_1768002591268.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6140585862aa050014501618/screenshot16_9_1768002591268.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6093ef2da0ccef00072b7cf8"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"actors":["Samuel West"],"directors":["Kenny Scott"],"producers":["Kenny Scott"],"originalReleaseDate":"2014-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6140585862aa050014501618/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=DE&serverSideAds=true&sessionID=42b2bf2d-d503-11f1-919e-e245b88e69f7&sid=42b2bf2d-d503-11f1-919e-e245b88e69f7&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..aEAj3PS_Y3ldZRE81O56a4M491H_65zkm5gOYgnpVoU&masterJWTPassthrough=true"},"646dd37c91275e001ad711dd-de":{"_id":"646dd37c91275e001ad711dd","seriesID":"646dd37b91275e001ad711be","slug":"flucht-aus-der-sklaverei-die-stadt-der-hoffnung-de-2017-1-1","name":"Flucht aus der Sklaverei - Die Stadt der Hoffnung","summary":"Der Great Dismal Swamp ist ein menschenfeindliches Sumpfgebiet nahe der Ostküste der USA. Archäologen machen hier eine Entdeckung, die ein neues Kapitel in der amerikanischen Geschichte erzählt. Entflohene Sklaven hielten sich zwischen dem 17. und 19.","description":"Der Great Dismal Swamp – übersetzt der Große Düstere Sumpf – ist ein gespenstisches, unwirtliches Sumpfgebiet nahe der Ostküste der USA. Es bedeckt große Teile der Küstenebenen der Bundesstaaten Virginia und North Carolina. Bis weit ins 19. Jahrhundert hinein war der Sumpf bei den Siedlern verhasst und gefürchtet. Er ist ein Paradies für giftige Wasserschlangen, blutsaugende Insekten, Spinnen und Raubtiere wie Schwarzbären und Luchse. Für Menschen – eine nasse, malariaverseuchte Hölle. Dennoch gab es immer Gerüchte, dass einst Menschen im Sumpf lebten. Verfolgte, die nirgends sonst hin konnten, weil sie überall gejagt und getötet wurden. Geflohene Sklaven – entkommen aus der brutalen Knechtschaft ihrer weißen Herren. Ein Team von Archäologen der American University in Washington DC geht den alten Gerüchten auf die Spur. Daniel Sayers und Becca Peixotto sind überzeugt, dass irgendwo im Sumpf eine menschliche Existenz möglich gewesen sein muss. Und tatsächlich: Bei einer Exkursion ins Innere des Dismal Swamp finden sie eine Insel. Trockener Grund, nur wenige Meter über dem Wasserspiegel. Sie beginnen mit Ausgrabungen und werden bald fündig. Die Archäologen stoßen auf jahrhundertealte Artefakte. Sie entdecken konkrete Hinweise auf eine Besiedlung. Dank moderner Datierungsmethoden können die Wissenschaftler beweisen, dass der Dismal Swamp nicht nur als vorübergehendes Versteck diente. Nein - hier, mitten im Sumpf, stand zwischen dem 17. und 19. Jahrhundert eine ganze Stadt. Eine Stadt der entflohenen Sklaven, die den Verfolgten Sicherheit und Zuflucht vor ihren Peinigern bot.","duration":3480000,"originalContentDuration":3015000,"allotment":3480,"rating":"6","featuredImage":{"path":"https://images.pluto.tv/episodes/646dd37c91275e001ad711dd/screenshot16_9_1767799302354.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/646dd37c91275e001ad711dd/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/646dd37c91275e001ad711dd/poster_1767799302354.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/646dd37c91275e001ad711dd/screenshot4_3_1767799302354.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/646dd37c91275e001ad711dd/screenshot16_9_1767799302354.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6093ef2da0ccef00072b7cf8"},{"id":"663ba0368e3e700013c1249b"},{"id":"663a2a2563e82700137e30b5"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"actors":["Armie Hicks Jr."],"directors":["Andreas Gutzeit"],"writers":["Julia Sassenberg"],"producers":["Andreas Gutzeit"],"originalReleaseDate":"2017-02-03T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/646dd37c91275e001ad711dd/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=DE&serverSideAds=true&sessionID=42b2bf2d-d503-11f1-919e-e245b88e69f7&sid=42b2bf2d-d503-11f1-919e-e245b88e69f7&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..aEAj3PS_Y3ldZRE81O56a4M491H_65zkm5gOYgnpVoU&masterJWTPassthrough=true"},"61652b8a6b2c51001ae9f0ff-de":{"_id":"61652b8a6b2c51001ae9f0ff","seriesID":"61652b886b2c51001ae9f0f9","slug":"v2-nazi-rocket-de-2016-1-1","name":"Hitlers Angriff aus dem All – Das Geheimnis der V2","summary":"Von der NS-Propaganda als „Wunderwaffe“ verklärt, sollte die V2 den Nazis im Zweiten Weltkrieg doch noch zum „Endsieg“ verhelfen. Die Geschichte dieser weltweit ersten voll funktionsfähigen Großrakete handelt von einer tödlichen Waffe – und von einer...","description":"Von der NS-Propaganda als „Wunderwaffe“ verklärt, sollte die V2 den Nazis im Zweiten Weltkrieg doch noch zum „Endsieg“ verhelfen. Die Geschichte dieser weltweit ersten voll funktionsfähigen Großrakete handelt von einer tödlichen Waffe – und von einer technischen Revolution. Im Mittelpunkt stehen der deutsche Ingenieur Wernher von Braun, der britische Geheimdienstagent Reginald Victor Jones, und der US-Soldat James Hamill, der das deutsche Know-how allzu gerne mit nach Amerika nehmen wollte.","duration":3000000,"originalContentDuration":2625000,"allotment":3000,"rating":"12","featuredImage":{"path":"https://images.pluto.tv/episodes/61652b8a6b2c51001ae9f0ff/screenshot16_9_1767839159733.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/61652b8a6b2c51001ae9f0ff/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/61652b8a6b2c51001ae9f0ff/poster_1767839159733.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/61652b8a6b2c51001ae9f0ff/screenshot4_3_1767839159733.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/61652b8a6b2c51001ae9f0ff/screenshot16_9_1767839159733.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6093ef2da0ccef00072b7cf8"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/61652b8a6b2c51001ae9f0ff/poster16_9_1767839159733.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"directors":["Andreas Gutzeit"],"writers":["Andreas Gutzeit"],"producers":["Carl Hall"],"originalReleaseDate":"2016-02-12T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/61652b8a6b2c51001ae9f0ff/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=DE&serverSideAds=true&sessionID=42b2bf2d-d503-11f1-919e-e245b88e69f7&sid=42b2bf2d-d503-11f1-919e-e245b88e69f7&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..aEAj3PS_Y3ldZRE81O56a4M491H_65zkm5gOYgnpVoU&masterJWTPassthrough=true"},"5b338c3ef01682ad80e6b0c7-de":{"_id":"5b338c3ef01682ad80e6b0c7","seriesID":"5b338c3ef01682ad80e6b0bf","slug":"hitlers-geheime-waffen-1-1","name":"Hitlers geheime Waffen","summary":"Während die Alliierten ihre Kräfte für die Invasion des Festlands von Europa bündelten, wurden die damals geheimen Raketen V1 und V2 auf Großbritannien geschickt.","description":"Während die Alliierten ihre Kräfte für die Invasion des Festlands von Europa bündelten, wurden die damals geheimen Raketen V1 und V2 auf Großbritannien geschickt.","duration":3540000,"originalContentDuration":3045000,"allotment":3540,"rating":"12","featuredImage":{"path":"https://images.pluto.tv/episodes/5b338c3ef01682ad80e6b0c7/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/5b338c3ef01682ad80e6b0c7/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/5b338c3ef01682ad80e6b0c7/poster.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/5b338c3ef01682ad80e6b0c7/screenshot4_3.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/5b338c3ef01682ad80e6b0c7/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6093ef2da0ccef00072b7cf8"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"originalReleaseDate":"2018-06-27T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/5b338c3ef01682ad80e6b0c7/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=DE&serverSideAds=true&sessionID=42b2bf2d-d503-11f1-919e-e245b88e69f7&sid=42b2bf2d-d503-11f1-919e-e245b88e69f7&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..aEAj3PS_Y3ldZRE81O56a4M491H_65zkm5gOYgnpVoU&masterJWTPassthrough=true"},"61921f85b7c957001ac61603-de":{"_id":"61921f85b7c957001ac61603","seriesID":"61921f83b7c957001ac615fd","slug":"projekt-natter-2014-1-1","name":"Projekt Natter – Hitlers letzte Waffe","summary":"Im Verlauf des Zweiten Weltkrieges versinken die deutschen Städte im Bombenhagel, der alliierten Luftstreitkräfte.","description":"Im Verlauf des Zweiten Weltkrieges versinken die deutschen Städte im Bombenhagel, der alliierten Luftstreitkräfte. Der materiellen Übermacht ist die deutsche Luftwaffe nicht mehr gewachsen. Erich Bachem, ein versierter Flugzeugingenieur, entwickelt einen raketengetriebenen Abfangjäger, der zum Schutz der Zivilbevölkerung und Punktzielen, eingesetzt werden soll. Im Wettlauf gegen die Zeit, entsteht so eine bahnbrechende Konstruktion, mit dem Suggestivnamen „Natter“. Seiner Zeit weit voraus, beinhaltet das Projekt „Natter“ modernste Technologien und Fertigungsprozesse, welche zukunftsweisend, noch heute in der Luft- und Raumfahrt anzutreffen sind. Die Erprobung verläuft erfolgreich und so findet kurz vor Kriegsende, der erste bemannte Raketenstart der Welt, im schwäbischen Stetten am kalten Markt, statt.","duration":2820000,"originalContentDuration":2460000,"allotment":2820,"rating":"12","featuredImage":{"path":"https://images.pluto.tv/episodes/61921f85b7c957001ac61603/screenshot16_9_1767829420127.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/61921f85b7c957001ac61603/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/61921f85b7c957001ac61603/poster_1767829420127.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/61921f85b7c957001ac61603/screenshot4_3_1767829420127.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{