rd.pluto.tv/v2/stitch/hls/episode/606c85fa8119a5001a7307cf/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=DE&serverSideAds=true&sessionID=42b2bf2d-d503-11f1-919e-e245b88e69f7&sid=42b2bf2d-d503-11f1-919e-e245b88e69f7&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..aEAj3PS_Y3ldZRE81O56a4M491H_65zkm5gOYgnpVoU&masterJWTPassthrough=true"},"6904830171d0752d875e7552-de":{"_id":"6904830171d0752d875e7552","seriesID":"6904830071d0752d875e7169","slug":"the-lady-vanishes-1938-1-1","name":"The Lady Vanishes","summary":"Auf einer Zugreise von Budapest nach Basel müssen die Passagiere nach einem Lawinenabgang in einem Gasthof übernachten. Iris lernt dort Miss Froy kennen. Nach einem Unfall verschwindet Miss Froy, und Iris macht sich mit Gilbert auf die Suche nach ihr.","description":"Auf einer Zugreise von Budapest nach Basel müssen die Passagiere, aufgrund eines Lawinenabgangs, für eine Nacht in einem überfüllten Gasthof ausharren. Dort lernt die junge Iris Henderson (Margaret Lockwood) die nette ältere Dame „Miss Froy“ (May Whitty) kennen. Nach einem unglücklichen Unfall am nächsten Morgen verliert Iris das Bewusstsein und wird von der hilfsbereiten Miss Froy in den abfahrbereiten Zug geleitet. Nach einem gemeinsamen Tee im Speisewagen schläft die immer noch leicht benommene Iris kurz ein. Als sie wieder erwacht, ist Miss Froy plötzlich verschwunden. Auf ihrer Suche stellt Iris nun fest, dass sich scheinbar niemand mehr an die nette Miss Froy erinnern kann. Erst als Gilbert Redman (Michael Redgrave) sich dem mysteriösen Verschwinden annimmt, kommt Bewegung in diesen Fall. Können die beiden gemeinsam den Fall der verschwundenen Dame lösen?","duration":6569000,"originalContentDuration":5504000,"allotment":6569,"rating":"12","featuredImage":{"path":"https://images.pluto.tv/episodes/6904830171d0752d875e7552/screenshot16_9_1761903364872.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Thriller","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6904830171d0752d875e7552/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6904830171d0752d875e7552/poster_1761903364486.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6904830171d0752d875e7552/screenshot4_3_1761903365337.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6904830171d0752d875e7552/screenshot16_9_1761903364872.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5cd15239d9e0ec55c4ecc014"},{"id":"60ec0f27db8a3a0007ade738"},{"id":"65ccb4723af63d00087f4c55"},{"id":"642aea9bb065d90008667006"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6904830171d0752d875e7552/poster16_9_1761903365746.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Paul Lukas","Cecil Parker","Naunton Wayne","Emile Boreo","Margaret Lockwood","Michael Redgrave","May Whitty","Linden Travers","Basil Radford","Mary Clare"],"directors":["Alfred Hitchcock"],"originalReleaseDate":"1938-10-07T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6904830171d0752d875e7552/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVers