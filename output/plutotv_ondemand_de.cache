9c69920a04f6d7f089b3/poster16_9_1783929962567.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Benno Fürmann","Jürgen Vogel","Mehmet Kurtulus","Heike Makatsch","Alexandra Maria Lara / Riley","Nina Hoss","Alexandra Maria Lara"],"directors":["Doris Dörrie"],"producers":["Norbert Preuss","Bernd Eichinger"],"originalReleaseDate":"2002-09-02T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6a549c69920a04f6d7f089b3/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=DE&serverSideAds=true&sessionID=42b2bf2d-d503-11f1-919e-e245b88e69f7&sid=42b2bf2d-d503-11f1-919e-e245b88e69f7&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..aEAj3PS_Y3ldZRE81O56a4M491H_65zkm5gOYgnpVoU&masterJWTPassthrough=true"},"620e1293df454b001354c21d-de":{"_id":"620e1293df454b001354c21d","seriesID":"620e1292df454b001354c216","slug":"die-kleinen-und-die-bosen-2015-1-1","name":"Die Kleinen und die Bösen","summary":"Regisseur Markus Sehr lässt in einer schrägen Komödie Theaterurgestein Peter Kurth und Stromberg-Star Christoph Maria Herbst aufeinander los.","description":"Bewährungshelfer Benno (Christoph Maria Herbst) findet in Hotte (Peter Kurth) eine echte Herausforderung. Beschissen wird seine Behörde von Kleinkriminellen ohnehin, aber Hotte ist mit Abstand der dreisteste Gauner, der sein Büro jemals betreten hat. Als Hotte auch noch das Sorgerecht für seine beiden Kinder Dennis (Jasper Smets) und Jenny (Emma Bading) zugesprochen wird, sieht Benno rot. Auf keinen Fall darf Hotte mit den Halbwüchsigen in eine gemeinsame Wohnung ziehen und deren Erziehung übernehmen. Den interessiert zunächst nur das Kindergeld, aber langsam findet er Gefallen an dem Zusammenleben mit seinen Kindern und einem festen Wohnsitz. Und während Hotte sich aufrichtig bemüht, sein Leben neu zu ordnen, entwickelt Benno eine ungeahnte Energie, um genau dieses zu verhindern... Regisseur Markus Sehr lässt in einer schrägen Komödie Theaterurgestein Peter Kurth und Stromberg-Star Christoph Maria Herbst aufeinander los. „Die Kleinen und die Bösen“ ist eine schwarzhumorige Abrechnung mit der Arbeit von Bewährungshelfern und gleichzeitig eine Liebeserklärung an Kleinkriminelle mit Herz.","duration":6480000,"originalContentDuration":5655000,"allotment":6480,"rating":"FSK-12","featuredImage":{"path":"https://images.pluto.tv/episodes/620e1293df454b001354c21d/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Comedy","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/620e1293df454b001354c21d/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/620e1293df454b001354c21d/poster.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/620e1293df454b001354c21d/screenshot4_3.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/620e1293df454b001354c21d/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"65cca4c43ef47d0008632365"},{"id":"60ec1639535a680007bcc6a6"},{"id":"642aea9bb065d90008667006"},{"id":"69de4a74029c431826dffe0c"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/620e1293df454b001354c21d/poster16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Christoph Maria Herbst","Dorka Gryllus","Emma Bading"],"directors":["Markus Sehr"],"writers":["Martin Ritzenhoff","Xao Seffcheque"],"producers":["Christine Kiauk","Herbert Schwering"],"originalReleaseDate":"2015-09-03T00:00