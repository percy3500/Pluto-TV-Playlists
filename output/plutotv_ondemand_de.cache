ndiger Kampf, seinen Kindern traditionelle Familienwerte zu vermitteln. Seine modernen, lebenslustigen Söhne Tony und Abdul glauben dagegen, alles im Griff zu haben. Als die Jungs entdecken, dass ihr Vater heimlich ihre Hochzeiten arrangiert hat, bricht die jugendliche Rebellion aus.","duration":6894000,"originalContentDuration":5814000,"allotment":6894,"rating":"6","featuredImage":{"path":"https://images.pluto.tv/episodes/6a956721ef1ef9477926712d/screenshot16_9_1788176162244.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Comedy","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6a956721ef1ef9477926712d/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6a956721ef1ef9477926712d/poster_1788176162244.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6a956721ef1ef9477926712d/screenshot4_3_1788176162244.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6a956721ef1ef9477926712d/screenshot16_9_1788176162244.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5cd15239d9e0ec55c4ecc014"},{"id":"62c8070758cb950007826487"},{"id":"60ec1639535a680007bcc6a6"},{"id":"642aea9bb065d90008667006"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6a956721ef1ef9477926712d/poster16_9_1788176162244.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Om Puri","Linda Bassett","Jordan Routledge","Archie Panjabi","Emil Marwa","Chris Bisson","Jimi Mistry","Lesley Nicol","Raji James","Ian Aspinall"],"directors":["Damien O'Donnell"],"producers":["Leslee Udwin"],"originalReleaseDate":"1999-05-14T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6a956721ef1ef9477926712d/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0