ächst, hängt Tom mit Pappass (Robin Williams) ab, einem geistig behinderten Mann. Toms Mutter (Téa Leoni) kämpft nach dem Tod ihres Mannes mit Depressionen und Tom wird sich selbst überlassen. Als er sich in die Schulkameradin Melissa verliebt ist, fühlt sich Pappass verlassen und fängt an, sich unberechenbar zu verhalten.","duration":6720000,"originalContentDuration":5835000,"allotment":6720,"rating":"12","featuredImage":{"path":"https://images.pluto.tv/episodes/636e163a41c0980014a38d22/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Drama","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/636e163a41c0980014a38d22/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/636e163a41c0980014a38d22/poster.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/636e163a41c0980014a38d22/screenshot4_3.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/636e163a41c0980014a38d22/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"61cc79898413090007c67792"},{"id":"62c8070758cb950007826487"},{"id":"65ccb4723af63d00087f4c55"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"actors":["Robin Williams","David Duchovny","Anton Yelchin","Téa Leoni","Frank Langella"],"directors":["David Duchovny"],"producers":["Adam Merims","Jeff Skoll"],"originalReleaseDate":"2004-05-07T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/636e163a41c0980014a38d22/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600