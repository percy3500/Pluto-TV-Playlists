er des Chauffeurs der Familie, erwachsen und glamourös aus Paris zurückkehrt, löst dies ein Feuerwerk in der Familie aus, denn die Brüder fallen in den Bann von Hepburns entzückendem Charme.","duration":7891000,"originalContentDuration":6811000,"allotment":7891,"rating":"12","featuredImage":{"path":"https://images.pluto.tv/episodes/6a84002120b6387cd0234899/screenshot16_9_1787035682255.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Comedy","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6a84002120b6387cd0234899/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6a84002120b6387cd0234899/poster_1787035682255.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6a84002120b6387cd0234899/screenshot4_3_1787035682255.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6a84002120b6387cd0234899/screenshot16_9_1787035682255.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"64ec9e930f73a8000813a0d0"},{"id":"5cd15239d9e0ec55c4ecc014"},{"id":"62175d34294eb7000736ae88"},{"id":"6839884d5058e53f887b0683"},{"id":"5f0dead91d386100072ae1ab"},{"id":"65ccb4723af63d00087f4c55"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6a84002120b6387cd0234899/poster16_9_1787035682255.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Humphrey Bogart","Audrey Hepburn","William Holden","John Williams","Walter Hampden","Francis X. Bushman","Martha Hyer","Joan Vohs","Marcel Dalio","Marcel Hillaire"],"directors":["Billy Wilder"],"originalReleaseDate":"1954-09-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6a84002120b6387cd0234899/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26