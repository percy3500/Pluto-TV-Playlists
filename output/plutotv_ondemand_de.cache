776974404302.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/66e0281ae087310013db9993/screenshot16_9_1776974404302.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"661fa049f4d5dd0013e5b354"},{"id":"642aea9bb065d90008667006"},{"id":"64ec9dce4c5ed800081b459d"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/66e0281ae087310013db9993/poster16_9_1776974404302.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Rebecca Ferguson","Charles Dance","Oliver Jackson-Cohen"],"directors":["Shamim Sarif"],"writers":["Shamim Sarif"],"originalReleaseDate":"2017-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/66e0281ae087310013db9993/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=DE&serverSideAds=true&sessionID=42b2bf2d-d503-11f1-919e-e245b88e69f7&sid=42b2bf2d-d503-11f1-919e-e245b88e69f7&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..aEAj3PS_Y3ldZRE81O56a4M491H_65zkm5gOYgnpVoU&masterJWTPassthrough=true"},"620e12c1df454b0013550fbe-de":{"_id":"620e12c1df454b0013550fbe","seriesID":"620e12c0df454b0013550fb7","slug":"tar-de-2015-1-1","name":"The Color of Time","summary":"Ein romantischer Road-Trip: Elf Regisseure erzählen in unterschiedlichen Segmenten vom Leben, Lieben und Leiden des Pulitzer-Preisträger C.K. Williams.","description":"Ein romantischer Road-Trip mit Starbesetzung. Elf Regisseure erzählen in unterschiedlichen Segmenten vom Leben, Lieben und Leiden des Pulitzer-Preisträger C.K. Williams. Als roter Faden dienen dabei einzelne Gedichte des berühmten Poeten. Der Film nimmt uns mit auf eine Reise zu verschiedenen Lebensabschnitte von C.K. Williams Kindheit bis hin zu seinem Dasein als erwachsener Mann. Wir sehen Detroit in den 1940ern, 1950ern, und 1980ern. C.K. (James Franco) und seine wunderschöne Frau Catherine (Mila Kunis) haben einen gemeinsamen Sohn namens Jed. C.K. bereitet sich auf eine Lesung seines Gedichtbandes „Tar“ in New York City vor und plagt sich durch die Nächte mit alten Erinnerungen und dem Wunsch, neue Gedichte schreiben zu können. Das Drama springt dabei in der Zeit zurück und vor, zeigt die liebevolle Beziehung zu seiner Mutter (Jessica Chastain), seine ersten sexuellen Erfahrungen als Teenager und seine erste Liebe. Der Film basiert auf dem Lyrikband Tar von C.K. Williams. Der Gedichtband wurde 1983 in den USA veröffentlicht. C.K. Williams gewann bereits nahezu jeden größeren Lyrikpreis, u.a. den Pulitzer-Preis für seine Lyriksammlung Repair.","duration":5040000,"originalContentDuration":4380000,"allotment":5040,"rating":"12","featuredImage":{"path":"https://images.pluto.tv/episodes/620e12c1df454b0013550fbe/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Drama","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/620e12c1df454b0013550fbe/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/620e12c1df454b0013550fbe/poster.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/620e12c1df454b0013550fbe/screenshot4_3.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/620e12c1df454b0013550fbe/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"661fa049f4d5dd0013e5b354"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/620e12c1df454b0013550fbe/poster16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"