tellt seinen Super-Computer Kronos vor. Als Kronos erkennt, dass der einzige Feind des weltweiten Friedens der Mensch selbst ist, rottet dieser über Nacht fast die gesamte Menschheit aus. 97 Jahre später hat nur noch eine kleine Zahl von Menschen überlebt und versteckt sich tagein tagaus vor den Killer-Maschinen.","duration":6049000,"originalContentDuration":5329000,"allotment":6049,"rating":"12","featuredImage":{"path":"https://images.pluto.tv/episodes/6ab4e9647102b85b82138765/screenshot16_9_1790620921715.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Drama","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6ab4e9647102b85b82138765/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6ab4e9647102b85b82138765/poster_1790620921715.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6ab4e9647102b85b82138765/screenshot4_3_1790620921715.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6ab4e9647102b85b82138765/screenshot16_9_1790620921715.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"64ec9e930f73a8000813a0d0"},{"id":"5cd15239d9e0ec55c4ecc014"},{"id":"61cc70b08a4d6500077ceec8"},{"id":"61cc75cd18447e00071833a5"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6ab4e9647102b85b82138765/poster16_9_1790620921715.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["John Cusack","Julian Schaffner","Carmen ArgenziaNo"],"directors":["Robert Kouba"],"originalReleaseDate":"2018-05-24T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6ab4e9647102b85b82138765/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false