oU&masterJWTPassthrough=true"},"5fe9de884aa70a001a4fdba4-de":{"_id":"5fe9de884aa70a001a4fdba4","seriesID":"5fe9de864aa70a001a4fdb9e","slug":"extreme-konstruktionen-das-grosste-zelt-der-welt-2013-1-1","name":"Extreme Konstruktionen – Das größte Zelt der Welt","summary":"Für seine neue Hauptstadt Astana gab der Präsident von Kasachstan das ultimative Gebäude des Space-Zeitalters in Auftrag.","description":"Für seine neue Hauptstadt Astana gab der Präsident von Kasachstan das ultimative Gebäude des Space-Zeitalters in Auftrag: ein 150 Meter hohes Zelt, in dem Geschäfte, ein Freizeitpark und ein tropischer Wasserpark mit Stränden und Wellen untergebracht werden sollen. Aber wie erzeugt man ein mediterranes Klima in einer Stadt, in der die Temperaturen im Winter unter 40 Grad minus fallen und im Sommer plus 40 Grad erreichen? Man engagiert den weltberühmten Architekten Sir Norman Foster und eine Reihe cleverer Ingenieure, die eine noch nie da gewesene Struktur erschaffen: das größte Zelt der Welt.","duration":2880000,"originalContentDuration":2520000,"allotment":2880,"rating":"FSK-6","featuredImage":{"path":"https://images.pluto.tv/episodes/5fe9de884aa70a001a4fdba4/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/5fe9de884aa70a001a4fdba4/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/5fe9de884aa70a001a4fdba4/poster.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/5fe9de884aa70a001a4fdba4/screenshot4_3.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/5fe9de884aa70a001a4fdba4/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"63e4e3e2c111bc0008f23c01"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"acto