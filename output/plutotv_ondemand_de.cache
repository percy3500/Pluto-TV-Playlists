,"originalContentDuration":5112000,"allotment":5832,"rating":"6","featuredImage":{"path":"https://images.pluto.tv/episodes/6a0333ce4c1064447f6d6267/screenshot16_9_1778594767285.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Western","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6a0333ce4c1064447f6d6267/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6a0333ce4c1064447f6d6267/poster_1778594767285.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6a0333ce4c1064447f6d6267/screenshot4_3_1778594767285.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6a0333ce4c1064447f6d6267/screenshot16_9_1778594767285.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5cd15239d9e0ec55c4ecc014"},{"id":"61cc79898413090007c67792"},{"id":"62c8070758cb950007826487"},{"id":"65ccb4723af63d00087f4c55"},{"id":"636a694e55d2e7000740d060"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6a0333ce4c1064447f6d6267/poster16_9_1778594767285.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Myrna Loy","Robert Mitchum","Peter Miles","Louis Calhern","Shepperd Strudwick","Margaret Hamilton","Melinda Byron","Jackie Jackson","Beau Bridges","Don Reynolds"],"directors":["Lewis Milestone"],"originalReleaseDate":"1949-03-08T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6a0333ce4c1064447f6d6267/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=DE&serverSideAds=