atio":"16:9","url":"https://images.pluto.tv/episodes/6041ea11e7c979001a897e41/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5cd15239d9e0ec55c4ecc014"},{"id":"68a484f249074cd91191347e"},{"id":"60ec1639535a680007bcc6a6"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6041ea11e7c979001a897e41/poster16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Robert De Niro","Demi Moore","Sean Penn","Wallace Shawn","Hoyt Axton","Ray McAnally","Bruno Kirby","James Russo","John C. Reilly","Jay Brazeau"],"directors":["Neil Jordan"],"writers":["Mitch Glazer","David Mamet"],"producers":["Fred Caruso","Robert De Niro","Art Linson"],"originalReleaseDate":"1989-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6041ea11e7c979001a897e41/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=DE&serverSideAds=true&sessionID=42b2bf2d-d503-11f1-919e-e245b88e69f7&sid=42b2bf2d-d503-11f1-919e-e245b88e69f7&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..aEAj3PS_Y3ldZRE81O56a4M491H_65zkm5gOYgnpVoU&masterJWTPassthrough=true"},"6980b25be090dedcb2fd4008-de":{"_id":"6980b25be090dedcb2fd4008","seriesID":"6980b25ae090dedcb2fd3fe9","slug":"nightride-2022-1-1","name":"Nightride - One Deal. One Night. One Shot.","summary":"Im packenden Thriller steht Budge vor einem letzten Deal. Als alles schiefgeht, kämpft er gegen die Zeit und einen gefährlichen Kredithai.","description":"Kleinganove Budge plant mit geliehenem Geld einen letzten großen Deal im nächtlichen Belfast, bevor er aus der Kriminalität aussteigen will. Doch sein Vorhaben läuft schief und er gerät in einen knallharten Wettlauf gegen die Zeit. Budge muss nicht nur seine verlorene Ware wieder auftreiben, sondern auch einen neuen Käufer finden.","duration":6960000,"originalContentDuration":5880000,"allotment":6960,"rating":"12","featuredImage":{"path":"https://images.pluto.tv/episodes/6980b25be090dedcb2fd4008/screenshot16_9_1770041948525.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Thriller","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6980b25be090dedcb2fd4008/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6980b25be090dedcb2fd4008/poster_1770041948525.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6980b25be090dedcb2fd4008/screenshot4_3_1770041948525.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6980b25be090dedcb2fd4008/screenshot16_9_1770041948525.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"68a484f249074cd91191347e"},{"id":"60ec0f27db8a3a0007ade738"},{"id":"642aea9bb065d90008667006"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6980b25be090dedcb2fd4008/poster16_9_1770041948525.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"originalReleaseDate":"2022-03-04T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6980b25be090dedcb2fd4008/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=DE&serverSideAds=true&sessionID=42b2bf2d-d503-11f1-919e-e245b88e69f7&sid=42b2bf2d-d503-11f1-919e-e245b88e69f7&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..aEAj3PS_Y3ldZRE81O56a4M491H_65zkm5gOYgnpVoU&masterJWTPassthrough=true"},"5ff81d09cc17ce00130b26af-de":{"_id":"5ff81d09cc17ce00130b26af","seriesID":"5ff81d08cc17ce00130b26a9","slug":"frontera-de-2015-1-1","name":"Frontera","summary":"Drama an der Grenze zwischen USA und Mexiko: Die Frau eines Ex-Sheriffs wird bei einem Ausritt erschossen. Die Tat soll einem illegal eingewanderten Mexikaner in die Schuhe geschoben...","description":"Im Grenzgebiet zwischen den USA und Mexiko wird die Frau des ehemaligen Sheriffs (Ed Harris) während eines Ausrittes erschossen. Miguel (Michael Peña), ein Mexikaner, der versucht illegal in die USA einzuwandern, ist zur falschen Zeit am falschen Ort und wird schnell als vermeintlicher Mörder inhaftiert. Währenddessen versucht der Sheriff im Ruhestand den Fall aufzuklären, denn die bisherigen Ermittlungen der Polizei scheinen nur halbgar und nicht hieb- und stichfest zu sein. Auch die Frau des Angeklagten (Eva Longoria) ist von dessen Unschuld überzeugt und will sich mit dem vorschnellen Urteil nicht abfinden. Als sie in die Hände korrupter Schleuserbanden gerät, spitzt sich die Lage zu.","duration":6720000,"originalContentDuration":5910000,"allotment":6720,"rating":"FSK-12","featuredImage":{"path":"https://images.pluto.tv/episodes/5ff81d09cc17ce00130b26af/screenshot16_9_1767395881314.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Drama","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/5ff81d09cc17ce00130b26af/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/5ff81d09cc17ce00130b26af/poster_1767395881314.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/5ff81d09cc17ce00130b26af/screenshot4_3_1767395881314.jpg?fill=blur&fit