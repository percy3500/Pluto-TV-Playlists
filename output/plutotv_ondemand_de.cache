],"categories":[{"id":"61a9fa3b79a4390007c621ae"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"directors":["Julian Roman Pölsler"],"writers":["Julian Roman Pölsler","Klaus T. Steindl","Andreas Sulzer"],"producers":["a co-production by ORF","epo-film","Smithsonian Channel and ARTE"],"originalReleaseDate":"2013-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/63281cc86cb7a00013a6d322/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=DE&serverSideAds=true&sessionID=42b2bf2d-d503-11f1-919e-e245b88e69f7&sid=42b2bf2d-d503-11f1-919e-e245b88e69f7&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..aEAj3PS_Y3ldZRE81O56a4M491H_65zkm5gOYgnpVoU&masterJWTPassthrough=true"},"61921f4128bfa6001c09fb48-de":{"_id":"61921f4128bfa6001c09fb48","seriesID":"61921f4028bfa6001c09fb42","slug":"le-mystere-de-la-sainte-lance-de-2021-1-1","name":"Das Rätsel um die heilige Lanze","summary":"Konstantin der Große suchte nach ihr, ebenso wie Napoleon und Hitler. Die Heilige Lanze, auch bekannt als Speer des Schicksals, ist eine der faszinierendsten christlichen Reliquien.","description":"Konstantin der Große suchte nach ihr, ebenso wie Napoleon und Hitler. Die Heilige Lanze, auch bekannt als Speer des Schicksals, ist eine der faszinierendsten christlichen Reliquien. Der römische Legionär Longinus soll sie dem gekreuzigten Jesus in die Seite gestoßen haben. Nun begeben sich Filmemacher in Jerusalem, Paris und Wien auf Spurensuche. In einer Kombination aus naturwissenschaftlichen und historischen Recherchen zeichnen sie die zweitausendjährige Geschichte der legendären Waffe nach.","duration":3600000,"originalContentDuration":3135000,"allotment":3600,"rating":"6","featuredImage":{"path":"https://images.pluto.tv/episodes/61921f4128bfa6001c09fb48/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/61921f4128bfa6001c09fb48/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/61921f4128bfa6001c09fb48/poster.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/61921f4128bfa6001c09fb48/screenshot4_3.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/61921f4128bfa6001c09fb48/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"61a9fa3b79a4390007c621ae"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"actors":["Arne Hörmann"],"directors":["François Barré"],"writers":["François Barré"],"producers":["Samuel Kissous"],"originalReleaseDate":"2021-01-28T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/61921f4128bfa6001c09fb48/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=DE&serverSideAds=true&sessionID=42b2bf2d-d503-11f1-919e-e245b88e69f7&sid=42b2bf2d-d503-11f1-919e-e245b88e69f7&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..aEAj3PS_Y3ldZRE81O56a4M491H_65zkm5gOYgnpVoU&masterJWTPassthrough=true"},"61921f4af17779001abacc5d-de":{"_id":"61921f4af17779001abacc5d","seriesID":"61921f49f17779001abacc57","slug":"le-mystere-de-la-grotte-de-lourdes-de-2020-1-1","name":"Das Geheimnis der Wunder von Lourdes","summary":"Was genau sind eigentlich Wunder? Wann erkennt die katholische Kirche sie offiziell an? Und kann die Wissenschaft wirklich für alle eine Erklärung liefern?","description":"Was genau sind eigentlich Wunder? Wann erkennt die katholische Kirche sie offiziell an? Und kann die Wissenschaft wirklich für alle eine Erklärung liefern? Um ein besseres Verständnis für derartige Phänomene zu entwickeln, widmet sich dieser Film der berühmten Grotte von Massabielle bei Lourdes. In den vergangenen 160 Jahren sollen sich hier 69 Wunderheilungen ereignet haben. Die Filmemacher stellen Nachforschungen an und beleuchten die faszinierenden Ereignisse in ihrem historischen Kontext.","duration":3600000,"originalContentDuration":3120000,"allotment":3600,"rating":"6","featuredImage":{"path":"https://images.pluto.tv/episodes/61921f4af17779001abacc5d/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/61921f4af17779001abacc5d/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/61921f4af17779001abacc5d/poster.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/61921f4af17779001abacc5d/screenshot4_3.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/61921f4af17779001abacc5d/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"61a9fa3b79a4390007c621ae"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"actors":["Lemmy Constantine"],"directors":["Françoi