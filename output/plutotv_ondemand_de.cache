nsNumbers":[],"stitched":{"path":"/stitch/hls/episode/69e8c3818f919a54cf283085/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/69e8c3818f919a54cf283085/poster_1776862082766.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/69e8c3818f919a54cf283085/screenshot4_3_1776862082766.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/69e8c3818f919a54cf283085/screenshot16_9_1776862082766.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6703e768cd7a12000ff4f49b"},{"id":"5e29ae56dd7984000996d3eb"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/69e8c3818f919a54cf283085/poster16_9_1776862082766.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"originalReleaseDate":"2014-04-06T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/69e8c3818f919a54cf283085/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=DE&serverSideAds=true&sessionID=42b2bf2d-d503-11f1-919e-e245b88e69f7&sid=42b2bf2d-d503-11f1-919e-e245b88e69f7&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..aEAj3PS_Y3ldZRE81O56a4M491H_65zkm5gOYgnpVoU&masterJWTPassthrough=true"},"646dd37991275e001ad710ee-de":{"_id":"646dd37991275e001ad710ee","seriesID":"646dd37891275e001ad710cf","slug":"duell-ums-weisse-haus-die-us-wahlkampfschlachten-de-2016-1-1","name":"Duell ums Weiße Haus - Große Wahlkämpfe","summary":"Die Dokumentation \"Duell ums Weiße Haus\" blickt hinter die Kulissen amerikanischer Präsidentschaftswahlkämpfe von Kennedy bis Obama. Vom ersten Fernsehduell bis zum Milliarden-Dollar-Business, immer wieder wurden in den USA neue Methoden entwickelt.","description":"Kein Wahlkampf ist so unbarmherzig, so aufwendig und so teuer wie der amerikanische Präsidentschaftswahlkampf. Gut 200 Millionen Wähler entscheiden, wer der mächtigste Mann oder die mächtigste Frau der Welt werden wird. Bevor es so weit ist, gibt es alle vier Jahre ein einzigartiges Kampagnen-Marathon. Die Dokumentation \"Duell ums Weiße Haus\" blickt hinter die Kulissen der Wahlkämpfe vergangener Jahrzehnte. Sie erzählt von Duellen, die Geschichte geschrieben haben: Von der ersten TV-Debatte Kennedy gegen Nixon 1960 über den Watergate-Einbruch beim Wahlkampf 1972 bis hin zum Sieg der Internet-Strategie von Barack Obama 2008. Jedes Duell hatte seine eigene Geschichte. Immer wieder haben die Wahlstrategen neue Techni- ken entwickelt: Politische Attacken und Showbusiness-Methoden, alle Register wurden gezogen. In den 60er und 70er Jahren werden die Berater professioneller. Immer besser verstehen sie die Gesetze des Mediums Fernsehen, immer effektiver nutzen sie es aus. Die Wahlkämpfer kommunizieren nicht nur politische Inhalte, sie appellieren oft nur noch an Emotionen. In den 80er Jahren wird ausgetestet, wie weit die Kandidaten mit persönlichen Angriffen auf den Gegner gehen können, ohne sich selbst zu schaden. Mit dem Aufkommen zahlloser neuer Fernsehkanäle richtet sich die Wahlwerbung immer gezielter an kleine Gruppen von potentiellen Wählern. Und das Internet eröffnet nicht nur neue Wege der Finanzierung durch massenhafte Kleinspenden, es erlaubt durch ungeahnte Möglichkeiten der Datensammlung sogar die scheinbar persönliche Ansprache individueller Wähler.","duration":3840000,"originalContentDuration":3150000,"allotment":3840,"rating":"FSK-0","featuredImage":{"path":"https://images.pluto.tv/episodes/646dd37991275e001ad710ee/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/646dd37991275e001ad710ee/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/646dd37991275e001ad710ee/poster.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/646dd37991275e001ad710ee/screenshot4_3.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/646dd37991275e001ad710ee/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6703e768cd7a12000ff4f49b"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"directors":["Ingo Helm"],"producers":["ECO Media TV-Produktion GmbH"],"originalReleaseDate":"2016-10-31T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/646dd37991275e001ad710ee/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=DE&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.4600&deviceLon=12.3500&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=DE&serverSideAds=true&sessionID=42b2bf2d-d503-11f1-919e-e245b88e69f7&sid=42b2bf2d-d503-11f1-919e-e245b88e69f7&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..aEAj3PS_Y3ldZRE81O56a4M491H_65zkm5gOYgnpVoU&masterJWTPassthrough=true"},"69e8bf498f919a54cf27bde1-de":{"_id":"69e8bf498f919a54cf27bde1","seriesID":"69e8bf488f919a54cf27bdc3","slug":"am-ballermann-von-thailand-deutsche-unter-palmen-2017-1-1","name":"Am Ballermann von Thailand - Deutsche unter Palmen","summary":"Pattaya, Thailands Partyhochburg: Die Reportage ze