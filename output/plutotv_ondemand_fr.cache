ce8/screenshot4_3.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/656091b0d68a2000131b2ce8/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"66d9b6eaab6c820008e5784d"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/656091b0d68a2000131b2ce8/poster16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Anne-Lise Rousset"],"directors":["Mouss Films"],"originalReleaseDate":"2022-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/656091b0d68a2000131b2ce8/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"6ab3c64b78e140e3e485c18a-fr":{"_id":"6ab3c64b78e140e3e485c18a","seriesID":"6ab3c64a78e140e3e485c16c","slug":"soda-le-reve-americain-2015-1-1","name":"SODA: Le rêve américain","summary":"Après son échec au bac, Adam voit son rêve américain s’envoler et se retrouve stagiaire dans la banque de son père. Avec Slim et Ludo, il tente alors de gagner un jeu télévisé dont le prix pourrait enfin lui ouvrir les portes des States...","description":"Adam rencontre à nouveau d'importantes déconvenues. En effet, ayant raté son bac, il est condamné à effectuer un stage dans la banque de son père, en lieu et place de son été aux États-Unis. Alors que sa situation familiale se complique, il n'abandonne pas ses envies d'ailleurs et décide de participer, avec Slim et Ludo, à un jeu télé pour gagner un visa d'un an au pays de l'Oncle Sam et ainsi vivre le rêve américain. La famille Fontella fait donc face à un tout nouveau défi...","duration":5605000,"originalContentDuration":5245000,"allotment":5605,"rating":"P","featuredImage":{"path":"https://images.pluto.tv/episodes/6ab3c64b78e140e3e485c18a/screenshot16_9_1790166604034.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Comedy","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6ab3c64b78e140e3e485c18a/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6ab3c64b78e140e3e485c18a/poster_1790166604034.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6ab3c64b78e140e3e485c18a/screenshot4_3_1790166604034.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6ab3c64b78e140e3e485c18a/screenshot16_9_1790166604034.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6093a40748d3200007b06a32"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6ab3c64b78e140e3e485c18a/poster16_9_1790166604034.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Kev Adams","William Lebghil","Gaël Cottat","Laurence Oltuski","Guy Lecluyse","Jéromine Chasseriaud","Syrielle Mejias","Louise Blachère","Dominique Frot","Alika Del Sol"],"directors":["Nath Dumont"],"producers":["Nicolas Coppermann","Jean-Yves Robin"],"originalReleaseDate":"2015-12-30T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6ab3c64b78e140e3e485c18a/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"6ab3c64d78e140e3e48635d4-fr":{"_id":"6ab3c64d78e140e3e48635d4","seriesID":"6ab3c64c78e140e3e48635b5","slug":"soda-un-trop-long-week-end-2014-1-1","name":"SODA: Un trop long week-end","summary":"Tension maximale chez les Fontella ! Michel joue sa carrière face au patron de la Banque Juhel. Adam, lui, visite l’appartement de ses rêves. Mais avec qui l’habiter ? Ses potes Slim et Ludo, ou Juliette, son amour… et la fille du patron de son père ?","description":"Tension maximum chez les Fontella : le père et le fils jouent leur vie ! En effet, Michel Fontella, le père, a rendez-vous avec son patron pour tenter d’obtenir le poste tant convoité de Directeur de région de la Banque Juhel. Son fils, Adam Fontella, s’apprête à visiter un appartement de rêve dans lequel il compte bien emménager. Adam doit choisir : emménager oui, mais avec qui ? C’est bien le problème, parce qu’Adam l’a promis à ses meilleurs amis, Slim et Ludo d’une part, et à Juliette, la femme de sa vie d’autre part. Et Juliette n’est autre que la fille de Jean-Jérôme Juhel, le patron de son père, qui tient l’avenir professionnel de Michel et l’avenir sentimental d’Adam entre ses mains. Que sa fille adorée emménage avec un Fontella ? Pourquoi pas, à condition de faire connaissance avant. Voici donc la famille Fontella invitée à passer le prochain week-end dans la propriété des Juhel, avec deux objectifs : décrocher une promotion pour Michel, et séduire Juliette pour Adam. Et pour Slim et Ludo, récupérer leur pote à tout prix. Ce week-end va s’annoncer beaucoup, mais alors beaucoup plus long que prévu...","duration":5072000,"originalContentDuration":4712000,"allotment":5072,"rating":"P","featuredImage":{"path":"https://images.pluto.tv/episodes/6ab3c64d78e140e3e48635d4/screenshot16_9_1790166607212.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Comedy","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6ab3c64d78e140e3e48635d4/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6ab3c64d78e140e3e48635d4/poster_1790166607212.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6ab3c64d78e140e3e48635d4/screenshot4_3_1790166607212.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6ab3c64d78e140e3e48635d4/screenshot16_9_1790166607212.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6093a40748d3200007b06a32"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6ab3c64d78e140e3e48635d4/poster16_9_1790166607213.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Kev Adams","William Lebghil","Gaël Cottat","Laurence Oltuski","Guy Lecluyse","Jéromine Chasseriaud","Syrielle Mejias","Louise Blachère","Dominique Frot","Alika Del Sol"],"directors":["Jean-Michel Ben Soussan","Jean-Michel Bensoussan"],"originalReleaseDate":"2014-12-29T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6ab3c64d78e140e3e48635d4/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID