540&q=75&w=960"}],"categories":[{"id":"6074608bb672c30007b43258"},{"id":"6021103d6e9401000778dbde"},{"id":"62062df5ba9a0f00077ba84e"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6a2ba76cdee9a631d0579737/poster16_9_1781245805780.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Andrew J Katers","Alexa Mansour","Tonya Kay Evan Sloan","Kayla Ewell","Tonya Kay","Evan Sloan","Detra Hicks","Kelcey Watson","Jose Rosete","Gabriel Del Vecchio"],"directors":["Nick Lyon"],"producers":["Anthony Fankhauser"],"originalReleaseDate":"2015-12-31T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6a2ba76cdee9a631d0579737/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"6a2ba76adee9a631d057352e-fr":{"_id":"6a2ba76adee9a631d057352e","seriesID":"6a2ba769dee9a631d057350f","slug":"snowmageddon-2011-1-1","name":"Snowmageddon","summary":"Une mystérieuse boule à neige est retrouvée par la famille Miller sur le pas de leur porte. Dès la première utilisation, une série de catastrophes naturelles inexplicables se déclenche sur la ville et peu à peu dans le monde entier.","description":"Une mystérieuse boule à neige, à l'énergie très étrange, est retrouvée par la famille Miller sur le pas de leur porte, emballée dans un paquet semblable à celui d'un cadeau de Noël. Dès la première utilisation de l'objet, une série de catastrophes naturelles inexplicables se déclenche sur la ville des Miller et peu à peu dans le monde entier.","duration":5467000,"originalContentDuration":5107000,"allotment":5467,"rating":"10","featuredImage":{"path":"https://images.pluto.tv/episodes/6a2ba76adee9a631d057352e/screenshot16_9_1781245803433.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Sci-Fi & Fantasy","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6a2ba76adee9a631d057352e/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6a2ba76adee9a631d057352e/poster_1781245803433.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6a2ba76adee9a631d057352e/screenshot4_3_1781245803433.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6a2ba76adee9a631d057352e/screenshot16_9_1781245803433.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6074608bb672c30007b43258"},{"id":"6021103d6e9401000778dbde"},{"id":"62062df5ba9a0f00077ba84e"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6a2ba76adee9a631d057352e/poster16_9_1781245803433.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Nicola Peltz","Greg Evigan","John Schneider","Laura de Carteret","Sophie Simmon","David Cubitt","Laura Harris","Dylan Matzke","Magda Apanowicz","Jeffrey Ballard"],"directors":["Sheldon Wilson"],"producers":["John Prince"],"originalReleaseDate":"2011-11-19T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6a2ba76adee9a631d057352e/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"6a282ebd114ca7fcbee6ba8d-fr":{"_id":"6a282ebd114ca7fcbee6ba8d","seriesID":"6a282ebc114ca7fcbee6ba6e","slug":"fathers-and-daughters-2015-1-1","name":"Père et fille","summary":"Le célèbre romancier Jake Davis et sa fille Katie, étudiante en psychologie, vivent tous les deux à New York et doivent faire face à leurs propres démons à 25 ans d'intervalle.","description":"Jake Davis, célèbre romancier,  est victime d’un accident de la route. Sa femme est tuée sur le coup, sa fille Katie s’en sort physiquement indemne. Lui souffre de graves séquelles : crises convulsives, troubles mentaux. Il passe 7 mois dans un établissement psychiatrique et, pendant son absence, confie sa fille à son oncle William, avocat, et à sa femme Elizabeth. A son retour,  Katie a l’air épanouie mais William et Elizabeth se sont mis en tête de l’adopter, ce qui révolte Jake. Ils affirment qu’il n’a plus les moyens d’élever sa fille. Pour finir, ils l’attaquent pour obtenir la garde de Katie. Jake doit hypothéquer sa maison pour payer son avocat. Il travaille par ailleurs jour et nuit à son nouveau roman « Pères et Filles », dans lequel il raconte son histoire et celle de sa fille. Mais  il meurt subitement.  Peu après, il remporte à titre posthume le prix Pulitzer pour « Pères et Filles ».\nDes années plus tard, Katie,  brillante étudiante en psycho,  travaille auprès d’enfants ayant des problèmes. Le soir, elle sort seule  dans des bars ou des boîtes et couche avec des inconnus de façon quasi compulsive,  jusqu’au jour où elle rencontre Cameron,  écrivain en herbe et grand admirateur de Jake Davis, qui tombe amoureux d’elle. Elle le trompe mais il finit par lui pardonner et l’aide à sortir de sa prison intérieure.","duration":7215000,"originalContentDuration":6675000,"allotment":7215,"rating":"10","featuredImage":{"path":"https://images.pluto.tv/episodes/6a282ebd114ca7fcbee6ba8d/screenshot16_9_1781018325455.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Drama","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6a282ebd114ca7fcbee6ba8d/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6a282ebd114ca7fcbee6ba8d/poster_1781018325455.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6a282ebd114ca7fcbee6ba8d/screenshot4_3_1781018325455.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6a282ebd114ca7fcbee6ba8d/screenshot16_9_1781018325455.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6074608bb672c30007b43258"},{"id":"5fd381616d048500077abd3e"},{"id":"5fd3802d138e4600075e1720"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6a282ebd114ca7fcbee6ba8d/poster16_9_1781018325455.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Russell Crowe","Amanda Seyfried","Aaron Paul","Diane Kruger."],"directors":["Gabriele Muccino"],"originalReleaseDate":"2015-10-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6a282ebd114ca7fcbee6ba8d/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c1