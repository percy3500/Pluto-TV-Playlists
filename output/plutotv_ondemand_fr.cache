es/6a3cfabe0eeacb372347bbed/screenshot4_3_1782381266112.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6a3cfabe0eeacb372347bbed/screenshot16_9_1782381266112.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6074608bb672c30007b43258"},{"id":"5fd381c283d6b70007dcffac"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6a3cfabe0eeacb372347bbed/poster16_9_1782381266112.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Bob Aguilar","Jim Babel","Jeffrey L. Barber","Nathaniel Barton","Michael I. Beckner Jr.","Frederick Byers III","Jason Cook"],"directors":["Jenny Chung"],"producers":["Nicolas Valcour","Tricia Tuberty Dozier","Dawn Wilfong"],"originalReleaseDate":"2021-02-14T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6a3cfabe0eeacb372347bbed/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"6a2f90ac9ee0ad741b162c40-fr":{"_id":"6a2f90ac9ee0ad741b162c40","seriesID":"6a2f90ab9ee0ad741b162c20","slug":"chateaubriand-2010-1-1","name":"Chateaubriand","summary":"C’est la vie d’un homme aux multiples facettes. Sans cesse déchiré entre le grandiose et l’inassouvi, il est l’homme de tous les désirs... Surtout les plus contradictoires.","description":"C’est la vie d’un homme aux multiples facettes. Sans cesse déchiré entre le grandiose et l’inassouvi, il est l’homme de tous les désirs... Surtout les plus contradictoires.\nIl osera le «Je» et il deviendra le premier écrivain romantique français. Un modèle pour les générations suivantes. À commencer par le jeune Victor Hugo. Il va connaître les derniers des fastes de la cour à Versailles. Et il va assister à la naissance du chemin de fer. Tous les personnages illustres de son temps, il va les côtoyer. Robespierre, Washington, Napoléon, Talleyrand, Louis XVIII, Charles X... Au carrefour de deux époques, il est un témoin capital des bouleversements qui donneront naissance au monde moderne.\nIl s’appelle François-René de Chateaubriand. Sa vie est un roman.","duration":6715000,"originalContentDuration":6175000,"allotment":6715,"rating":"P","featuredImage":{"path":"https://images.pluto.tv/episodes/6a2f90ac9ee0ad741b162c40/screenshot16_9_1781502125411.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Drama","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6a2f90ac9ee0ad741b162c40/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6a2f90ac9ee0ad741b162c40/poster_1781502125411.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6a2f90ac9ee0ad741b162c40/screenshot4_3_1781502125411.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6a2f90ac9ee0ad741b162c40/screenshot16_9_1781502125411.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6074608bb672c30007b43258"},{"id":"5fd381616d048500077abd3e"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6a2f90ac9ee0ad741b162c40/poster16_9_1781502125411.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Frédéric Diefenthal","Armelle Deutsch","Annelise Hesme","Jean-François Balmer","Audrey Fleurot","Aurélia Petit","Isabelle Tanakil","D