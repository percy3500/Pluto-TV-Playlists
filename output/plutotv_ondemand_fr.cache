techniques oblige le vaisseau du cosmonaute Chapaev à se poser d’urgence. Seul et livré à lui-même dans l’immensité de l’espace, il va rencontrer quelque chose d’inexplicable qui changera sa vie à jamais. Prisonnier de la planète rouge et devenu par son incroyable périble une légende vivante sur terre, Chapaev échappera-t-il à son destin ?","duration":5981000,"originalContentDuration":5441000,"allotment":5981,"rating":"10","featuredImage":{"path":"https://images.pluto.tv/episodes/69493159a7396485f8575afc/screenshot16_9_1766417959741.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Sci-Fi & Fantasy","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/69493159a7396485f8575afc/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/69493159a7396485f8575afc/poster_1766417959741.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/69493159a7396485f8575afc/screenshot4_3_1766417959741.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/69493159a7396485f8575afc/screenshot16_9_1766417959741.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6074608bb672c30007b43258"},{"id":"6021103d6e9401000778dbde"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/69493159a7396485f8575afc/poster16_9_1766417959741.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Andrey Smolyakov","Anna Banshchikova","Maxim Vitorgan"],"directors":["Alexander Kulikov"],"originalReleaseDate":"2018-11-08T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/69493159a7396485f8575afc/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1