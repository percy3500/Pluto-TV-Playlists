enny Tran","Natalie Storrs","Justin Tanks","Scott Williams","Karan Sagoo","Anthony Jensen"],"directors":["Noah Luke"],"producers":["David Michael Latt"],"originalReleaseDate":"2022-09-30T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/69382f9e0c94b0607811fcc2/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"69271fd182bb361505ef90aa-fr":{"_id":"69271fd182bb361505ef90aa","seriesID":"69271fcf82bb361505ef908b","slug":"the-deal-2023-1-1","name":"The Deal","summary":"Après une pandémie, le Bureau impose le \"Deal\" : 20 ans de confort, puis la mort. Tala, enceinte à l’époque, lutte pour que sa fille Analyn échappe à cet asservissement quand un diagnostic inattendu survient à cinq jours de sa mort programmée.","description":"Après qu'une pandémie sans précédent a ravagé l'humanité, une organisation totalitaire, le Bureau, a enfermé les survivants à l'intérieur d'une cité sans âme, où chaque individu est encouragé à signer le \"Deal”. Acceptez-le et vous recevrez emploi, logement et soins médicaux pendant vingt ans. Après quoi, vous devrez mourir et laisser votre place.\nTala Bayani a accepté le Deal quand elle était enceinte et seule. Depuis, elle a tout fait pour que sa fille Analyn n'ait pas à faire le même choix. Quand, cinq jours seulement avant la mort programmée de sa mère, Analyn reçoit un diagnostic médical inattendu, Tala va devoir se battre dans le peu de temps qu'il lui reste pour que sa fille échappe à l'asservissement à vie imposé par Le Deal.","duration":6258000,"originalContentDuration":5718000,"allotment":6258,"rating":"10","featuredImage":{"path":"https://images.pluto.tv/episodes/69271fd182bb361505ef90aa/screenshot16_9_1776243602236.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Sci-Fi & Fantasy","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/69271fd182bb361505ef90aa/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/69271fd182bb361505ef90aa/poster_1776243602236.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/69271fd182bb361505ef90aa/screenshot4_3_1776243602236.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/69271fd182bb361505ef90aa/screenshot16_9_1776243602236.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6074608bb672c30007b43258"},{"id":"6021103d6e9401000778dbde"},{"id":"600adc9f48fa810007b32701"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/69271fd182bb361505ef90aa/poster16_9_1776243602236.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Sumalee Montano","Emma Fischer","Alastair Mackenzie","Taz Skylar","Lisa Brenner","Pearl Mackie"],"directors":["Orsi Nagypal"],"originalReleaseDate":"2023-04-13T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/69271fd182bb361505ef90aa/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=