&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/691ed02aff9b3a4db7c7d413/screenshot16_9_1763627422977.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"692ef1b52c29259ae090be94"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/691ed02aff9b3a4db7c7d413/poster16_9_1763627422977.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Carlo Bonomi","Pietro Ubaldi"],"directors":["Seishi Katto","Javier Garcia"],"originalReleaseDate":"1997-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/691ed02aff9b3a4db7c7d413/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"6936a74a843d41d249af2653-fr":{"_id":"6936a74a843d41d249af2653","seriesID":"6936a749843d41d249af2634","slug":"team-hot-wheels-build-the-epic-race-2015-1-1","name":"Team Hot Wheels - Build the Epic Race","summary":"Team Hot Wheels crée la Méga Course, mais les Pirates de la Route veulent voler leur technologie ! Les héros doivent sauver la ville, vaincre les pirates et gagner la course… à toute vitesse !","description":"Dans la course la plus épique jamais vue, l’équipe Hot Wheels se lance dans une mission : créer le plus grand circuit de course de tous les temps… la Méga Course ! Dernière boucle, dernier dinosaure mordant, et la piste est terminée. Mais les ennuis, eux, ne font que commencer : une nouvelle bande de méchants arrive pour tout gâcher — les Pirates de la Route ! Cette bande sans scrupules veut tout piller, et leur plus grand trésor n’est autre que la technologie de Team Hot Wheels ! C’est maintenant une course contre la montre : l’équipe doit sauver la ville, récupérer sa technologie, gagner la course et vaincre les pirates… le tout à pleine vitesse !","duration":2862000,"originalContentDuration":2682000,"allotment":2862,"rating":"P","featuredImage":{"path":"https://images.pluto.tv/episodes/6936a74a843d41d249af2653/screenshot16_9_1765200495605.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Children & Family","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6936a74a843d41d249af2653/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6936a74a843d41d249af2653/poster_1765200495605.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6936a74a843d41d249af2653/screenshot4_3_1765200495605.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6936a74a843d41d249af2653/screenshot16_9_1765200495605.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"692ef1b52c29259ae090be94"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6936a74a843d41d249af2653/poster16_9_1765200495605.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Ben Diskin","Doug Erholtz","Jessica Gee-George","Grant George","David Lodge","Nicolas Roye","Faruq Tauheed"],"directors":["Matt Danner","Dan Fraga"],"producers":["Margaret M. Dean","Kimberly Smith"],"originalReleaseDate":"2015-10-05T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6936a74a843d41d249af2653/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"692feb3182c5f9296daccf93-fr":{"_id":"692feb3182c5f9296daccf93","seriesID":"692feb3082c5f9296daccf4a","slug":"team-hot-wheels-the-origin-of-awesome-2014-1-1","name":"Team Hot Wheels - The Origin of Awesome","summary":"Dans la ville la plus lente du monde, quatre pilotes forment Team Hot Wheels ! Ensemble, ils affrontent une voiture noire qui transforme tout en chaos et doivent sauver leur ville dans L’Origine du Génial !","description":"Dans la ville la plus leeeeeente du monde, quatre enfants chanceux vont découvrir que la vie est bien meilleure… pied au plancher ! Voici Gage, Wyatt, Brandon et Rhett — des enfants faits pour la vitesse. Séparément, ce sont des pilotes incroyablement doués, mais ensemble, ils deviennent TEAM HOT WHEELS ! Lorsqu’une mystérieuse voiture noire débarque en rugissant, les garçons ne savent pas quoi penser. Est-ce la chose la plus géniale jamais vue… ou la pire ? La voiture crée une piste orange géante partout où elle passe — c’est la partie géniale ! Mais elle provoque aussi des transformations folles, transformant tout ce qui n’est pas solidement fixé en monstre déchaîné — et ça, c’est la mauvaise partie ! Si ce méchant n’est pas arrêté, la ville entière sera réduite à un désert de destruction !\nAlors accrochez-vous : les garçons vont découvrir leur véritable esprit de coureurs, affronter des monstres mécaniques, survivre à des pistes chaotiques et apprendre à faire équipe pour sauver leur ville ! Ne vous contentez pas d’être génial… découvrez L’Origine du Génial !","duration":4834000,"originalContentDuration":4654000,"allotment":4834,"rating":"P","featuredImage":{"path":"https://images.pluto.tv/episodes/692feb3182c5f9296daccf93/screenshot16_9_1764802988096.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Children & Family","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/692feb3182c5f9296daccf93/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/692feb3182c5f9296daccf93/poster_1764802988096.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/692feb3182c5f9296daccf93/screenshot4_3_1764802988096.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/692feb3182c5f9296daccf93/screenshot16_9_1764802988096.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"692ef1b52c29259ae090be94"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/692feb3182c5f9296daccf93/poster16_9_1764802988096.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Ben Diskin","Jessica Gee-George","Grant George","Traian Virgil Georgescu","Nicolas Roye","David Lodge","Faruq Tauheed"],"directors":["Matt Danner"],"originalReleaseDate":"2014-06-07T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/692feb3182c5f9296daccf93/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"6936a744843d41d249ae4e4e-fr":{"_id":"6936a744843d41d249ae4e4e","seriesID":"6936a743843d41d249ae4e30","slug":"team-hot-wheels-skills-to-thrill-2014-1-1","name":"Team Hot Wheels - Skills to Thrill","summary":"Un inventeur vend des voitures sans conducteur à HW City ! Mais quand la liberté disparaît avec le volant, Team Hot Wheels doit reprendre la route pour sauver la ville et l’esprit de la conduite !","description":"Rejoignez la grande aventure automobile alors que Team Hot Wheels affronte le plus grand danger de tous… la mort de la conduite !\nLorsqu’un personnage suspect arrive en ville pour vendre ses nouvelles voitures sans conducteur, les D.O.R.C., les habitants de HW City sont ravis — du moins au début. Une voiture qui vous conduit au travail et vous prépare des gaufres ? Qui aurait encore besoin de Team Hot Wheels… ou de conduire ? Mais la ville découvre vite qu’en abandonnant le volant, elle abandonne aussi sa liberté !\nDe l’humour, de la folie et des courses pleines d’action — tout ce qu’on aime de Team Hot Wheels !\nDémarrez vos moteurs !","duration":2874000,"originalContentDuration":2694000,"allotment":2874,"rating":"P","featuredImage":{"path":"https://images.pluto.tv/episodes/6936a744843d41d249ae4e4e/screenshot16_9_1765189446817.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Children & Family","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6936a744843d41d249ae4e4e/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6936a744843d41d249ae4e4e/poster_1765189446817.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6936a744843d41d249ae4e4e/screenshot4_3_1765189446817.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6936a744843d41d249ae4e4e/screenshot16_9_1765189446817.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"692ef1b52c29259ae090be94"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6936a744843d41d249ae4e4e/poster16_9_1765189446817.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Ben Diskin","Jessica Gee-George","Grant George"],"directors":["Matt Danner"],"originalReleaseDate":"2015-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6936a744843d41d249ae4e4e/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"692ee4426a5d6e38601403b6-fr":{"_id":"692ee4426a5d6e38601403b6","seriesID":"692ee4416a5d6e3860140395","slug":"thomas-and-friends-the-great-discovery-2008-1-1","name":"Thomas & Friends: The Great Discovery","summary":"Le Contrôleur décrète qu’une ville disparue depuis longtemps doit être restaurée pour la Journée de Sodor. Thomas se sent menacé par l’arrivée de la nouvelle locomotive Stanley et, lorsqu’une farce se retourne contre lui, il se retrouve perdu.","description":"Le Contrôleur décrète qu’une ville disparue depuis longtemps doit être restaurée pour la Journée de Sodor. Thomas se sent menacé par l’arrivée de la nouvelle locomotive Stanley et, lorsqu’une farce se retourne contre lui, il se retrouve perdu. Sera‑t‑il retrouvé à temps pour la Journée de Sodor ?","duration":3849000,"originalContentDuration":3669000,"allotment":3849,"rating":"P","featuredImage":{"path":"https://images.pluto.tv/episodes/692ee4426a5d6e38601403b6/screenshot16_9_1764680771595.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Children & Family","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/692ee4426a5d6e38601403b6/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/692ee4426a5d6e38601403b6/poster_1764680771595.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/692ee4426a5d6e38601403b6/screenshot4_3_1764680771595.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/692ee4426a5d6e38601403b6/screenshot16_9_1764680771595.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"692ef1b52c29259ae090be94"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/692ee4426a5d6e38601403b6/poster16_9_1764680771595.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["TINA DESAI and JOHN HASLER","DAVID BEDELLA","JONATHAN FORBES","Pierce Brosnan"],"directors":["STEVE ASQUITH","Steve Asquith"],"producers":["Simon Spencer"],"originalReleaseDate":"2008-07-05T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/692ee4426a5d6e38601403b6/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sess