ion allemande. Jeu de rôle savant ou véritable voyage dans le temps ? Les événements qui se dérouleront au cours de leur séjour pourraient changer le cours du temps…","duration":5532000,"originalContentDuration":5172000,"allotment":5532,"rating":"10","featuredImage":{"path":"https://images.pluto.tv/episodes/6a8d9d137a5624e68df7c37e/screenshot16_9_1787665684637.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Sci-Fi & Fantasy","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6a8d9d137a5624e68df7c37e/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6a8d9d137a5624e68df7c37e/poster_1787665684637.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6a8d9d137a5624e68df7c37e/screenshot4_3_1787665684637.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6a8d9d137a5624e68df7c37e/screenshot16_9_1787665684637.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6074608bb672c30007b43258"},{"id":"6093a40748d3200007b06a32"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6a8d9d137a5624e68df7c37e/poster16_9_1787665684637.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Pierre Deladonchamps","Julia Piaton","Benjamin Wangermée","Maxime Dambrin","Laura Boujenah"],"directors":["Jonathan Helpert"],"originalReleaseDate":"2016-01-13T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6a8d9d137a5624e68df7c37e/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingR