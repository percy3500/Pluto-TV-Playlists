":{"path":"/stitch/hls/episode/69450fd94f5af45f9ec950ad/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/69450fd94f5af45f9ec950ad/poster_1766139690394.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/69450fd94f5af45f9ec950ad/screenshot4_3_1766139690394.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/69450fd94f5af45f9ec950ad/screenshot16_9_1766139690394.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"692ef1b52c29259ae090be94"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/69450fd94f5af45f9ec950ad/poster16_9_1766139690394.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["DAVID BEDELLA","TERESA GALLAGHER","STEVEN KYNMAN"],"directors":["GREG TIERNAN"],"originalReleaseDate":"2012-09-03T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/69450fd94f5af45f9ec950ad/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"69450fe04f5af45f9eca8a97-fr":{"_id":"69450fe04f5af45f9eca8a97","seriesID":"69450fe04f5af45f9eca8a79","slug":"thomas-and-friends-king-of-the-railway-s17-2013-1-1","name":"Thomas & Friends: King of the Railway (S17)","summary":"Un invité spécial arrive à Sodor avec une grande surprise et des missions importantes pour Thomas, Percy et James. Les locomotives se font de nouveaux amis et découvrent des armures, des blasons et des légendes de héros d’autrefois.","description":"Un invité spécial arrive à Sodor avec une grande surprise et des missions importantes pour Thomas, Percy et James. Les locomotives se font de nouveaux amis et découvrent des armures, des blasons et des légendes de héros d’autrefois. Leur courage est ensuite mis à l’épreuve lorsque leur nouvel ami Stephen disparaît. Thomas le retrouvera‑t‑il à temps ? Les locomotives découvriront‑elles la vérité sur le plus grand mystère de l’île de Sodor ?","duration":3758000,"originalContentDuration":3578000,"allotment":3758,"rating":"P","featuredImage":{"path":"https://images.pluto.tv/episodes/69450fe04f5af45f9eca8a97/screenshot16_9_1766169568688.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Children & Family","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/69450fe04f5af45f9eca8a97/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/69450fe04f5af45f9eca8a97/poster_1766169568688.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/69450fe04f5af45f9eca8a97/screenshot4_3_1766169568688.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/69450fe04f5af45f9eca8a97/screenshot16_9_1766169568688.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"692ef1b52c29259ae090be94"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/69450fe04f5af45f9eca8a97/poster16_9_1766169568688.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["DAVID BEDELLA","JONATHAN FORBES","TERESA GALLAGHER","BOB GOLDING","MIKE GRADY","TOGO IGAWA","STEVEN KYNMAN","MICHAEL LEGGE","REBECCA O’MARA","MIRANDA RAISON"],"directors":["ROB SILVESTRI"],"originalReleaseDate":"2013-09-02T00:00:00Z"},"