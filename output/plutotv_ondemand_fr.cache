iers de l'île de la Tortue, parle en connaissance de cause.","duration":6704000,"originalContentDuration":6164000,"allotment":6704,"rating":"10","featuredImage":{"path":"https://images.pluto.tv/episodes/686230603783a098609e4283/screenshot16_9_1768263121523.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Western","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/686230603783a098609e4283/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/686230603783a098609e4283/poster_1768263121523.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/686230603783a098609e4283/screenshot4_3_1768263121523.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/686230603783a098609e4283/screenshot16_9_1768263121523.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"623c40a558623500074b05d3"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/686230603783a098609e4283/poster16_9_1768263121523.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Lex Barker","Estella Blain","Livio Lorenzon"],"directors":["Domenico Paolella"],"originalReleaseDate":"1962-10-17T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/686230603783a098609e4283/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q