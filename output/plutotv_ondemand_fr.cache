60"}],"categories":[{"id":"61251190eb9daf000766e095"},{"id":"61251ad20e19d000076edf7a"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"actors":["Ron Perlman","Selma Blair","Doug Jones","Peri Gilpin"],"directors":["Phil Weinstein","Tad Stones"],"originalReleaseDate":"2006-04-10T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/60a6796e259b95001330e593/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"691b4ab908b2fa12fa89d262-fr":{"_id":"691b4ab908b2fa12fa89d262","seriesID":"691b4ab808b2fa12fa89d244","slug":"barbie-my-first-barbie-2023-1-1","name":"Ma première Barbie : Joyeuse Journée de Rêve !","summary":"Barbie prépare une fête surprise d’anniversaire à Chelsea !","description":"Chante avec Malibu, Brooklyn, Teresa et Renée tout au long de cette aventure musicale durant laquelle elles préparent la plus grande fête surprise d’anniversaire de tous les temps pour Chelsea. \"Plus qu’un simple anniversaire, nous organiserons une Journée de Rêve !\". Les filles unissent leurs forces et travaillent de concert avec l’appli intelligente de la Maison de Rêve pour organiser la fête. Dans la Maison de Rêve, il suffit d’y croire et de le vouloir pour qu’un vœu devienne réalité ! Mais lorsque leurs souhaits pour la fête se multiplient, la magie de la Maison de Rêve ne parvient pas à suivre le rythme et on frôle la catastrophe ! Est-ce que Barbie et ses amies réussiront à remettre de l’ordre dans tout ce bazar pour organiser cette Journée de Rêve avant que Chelsea n’arrive ? Découvre-le en regardant l’épisode spécial inédit de \"Ma Première Barbie\". Disponible sur YouTube et YouTube Kids sur la Chaîne Barbie.","duration":2584000,"originalContentDuration":2404000,"allotment":2584,"rating":"P","featuredImage":{"path":"https://images.pluto.tv/episodes/691b4ab908b2fa12fa89d262/screenshot16_9_1763407043203.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Children & Family","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/691b4ab908b2fa12fa89d262/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/691b4ab908b2fa12fa89d262/poster_1763407042682.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/691b4ab908b2fa12fa89d262/screenshot4_3_1763407043581.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/691b4ab908b2fa12fa89d262/screenshot16_9_1763407043203.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"692ef100d52ea9e4858e06b9"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/691b4ab908b2fa12fa89d262/poster16_9_1763407044006.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["DEWORST LUDIVINE","DUBOIS ALAYIN","PYRONNET SOPHIE"],"directors":["GKIZAS IOANNA"],"originalReleaseDate":"2023-02-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/691b4ab908b2fa12fa89d262/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"69402815f1f205fbbf9ab9fa-fr":{"_id":"69402815f1f205fbbf9ab9fa","seriesID":"69402814f1f205fbbf9ab9dc","slug":"monster-high-electrified-2016-1-1-ptv1","name":"Monster High: Electrified","summary":"Les goules de Monster High affrontent le plan ténébreux de Moanica ! Avec Twyla, elles sauvent la ville et ouvrent un salon électrisant, prouvant que leur amitié et leur énergie peuvent illuminer le monde !","description":"Tente de contenir ton énergie, car les goules de Monster High s’élancent dans une aventure électrisante ! En poursuivant leurs rêves de mode, elles déjouent le sombre complot de Moanica et illuminent le monde grâce à leur incroyable pouvoir et potentiel ! Quand Clawdeen rêve d’ouvrir un salon pour monstres et normies, Frankie trouve l’endroit idéal : une centrale électrique abandonnée à la sortie de la ville. Mais l’idée prend une tournure négative lorsque Moanica prépare un plan pour tout gâcher et remplacer la fête par quelque chose d’un peu plus… choquant ! Heureusement, les goules ont une arme secrète : Twyla, la fille du Croque-Mitaine, la goule parfaite pour percer tous les mystères. Avec ses amies, elle devra contrecarrer le plan de Moanica, recharger leurs tenues, sauver la ville normie des ténèbres… et ouvrir le salon le plus électrisant de tous ! Alors, ne rate aucun rebondissement, éclair, ni explosion… car les goules de Monster High sont prêtes à devenir ÉLECTRIQUES !","duration":4462000,"originalContentDuration":4282000,"allotment":4462,"rating":"P","featuredImage":{"path":"https://images.pluto.tv/episodes/69402815f1f205fbbf9ab9fa/screenshot16_9_1765812246398.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Children & Family","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/69402815f1f205fbbf9ab9fa/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/69402815f1f205fbbf9ab9fa/poster_1765812246398.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/69402815f1f205fbbf9ab9fa/screenshot4_3_1765812246398.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/69402815f1f205fbbf9ab9fa/screenshot16_9_1765812246398.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"692ef100d52ea9e4858e06b9"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/69402815f1f205fbbf9ab9fa/poster16_9_1765812246398.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Debi Derryberry","Cassandra Morris","Celeste Henderson"],"directors":["Avgousta Zourelidi"],"originalReleaseDate":"2017-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/69402815f1f205fbbf9ab9fa/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"6936a747843d41d249aeb034-fr":{"_id":"6936a747843d41d249aeb034","seriesID":"6936a746843d41d249aeb016","slug":"monster-high-new-ghoul-in-school-2009-1-1","name":"Monster High: New Ghoul in School","summary":"Nouvelle à Monster High, Frankie Stein, âgée de 15 jours, vit une semaine cauchemardesque en tentant de s’intégrer et de plaire à Cleo De Nile, la goule la plus populaire !","description":"Qui a dit qu’il était facile d’être la nouvelle goule à l’école ? C’est une première semaine horri-fique à Monster High pour Frankie Stein, âgée de seulement 15 jours, qui tente de s’intégrer, de se démarquer et de gagner la sympathie de la fille la plus populaire de l’école, Cleo De Nile. S’intégrer peut vite devenir un cauchemar ! Pour la nouvelle goule Frankie Stein, cette première semaine à Monster High est remplie de frayeurs alors qu’elle essaie de trouver sa place, de briller, et d’impressionner Cleo De Nile.","duration":1562000,"originalContentDuration":1382000,"allotment":1562,"rating":"P","featuredImage":{"path":"https://images.pluto.tv/episodes/6936a747843d41d249aeb034/screenshot16_9_1765189491629.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Children & Family","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6936a747843d41d249aeb034/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6936a747843d41d249aeb034/poster_1765189491629.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6936a747843d41d249aeb034/screenshot4_3_1765189491629.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6936a747843d41d249aeb034/screenshot16_9_1765189491629.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"692ef100d52ea9e4858e06b9"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6936a747843d41d249aeb034/poster16_9_1765189491629.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Kate Higgins","Salli Saffioti","Debi Derryberry"],"directors":["Audu Paden","Eric Radomski"],"originalReleaseDate":"2010-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6936a747843d41d249aeb034/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"6936a741843d41d249add830-fr":{"_id":"6936a741843d41d249add830","seriesID":"6936a740843d41d249add812","slug":"the-howliday-special-2016-1-1","name":"The Howliday Special","summary":"Draculaura crée une fête monstrueuse : la Howliday ! Mais les idées s’entrechoquent. Avec l’aide de ses amies, elle rappelle que les fêtes sont faites pour unir les cœurs. Et Frankie crée sa sœur : Alivia !","description":"Draculaura a une idée terrifiante lorsque son père donne un cours sur les fêtes humaines ! Elle convainc les élèves de Monster High qu’il est temps pour les monstres d’avoir leur propre fête — une Howliday ! Mais au lieu de rassembler tout le monde, les élèves s’affrontent avec leurs idées concurrentes, plongeant l’école dans un chaos… mortel. Les goules doivent alors unir leurs forces pour rappeler le vrai message : les fêtes sont faites pour la famille et l’unité. Pendant ce temps, Draculaura et Fangelica se rapprochent, se sentant plus comme des sœurs que comme de simples amies. Cette relation inspire aussi Frankie à créer sa propre sœur — Alivia !\nQue la célébration commence !","duration":2823000,"originalContentDuration":2643000,"allotment":2823,"rating":"P","featuredImage":{"path":"https://images.pluto.tv/episodes/6936a741843d41d249add830/screenshot16_9_1765189493531.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Children & Family","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6936a741843d41d249add830/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6936a741843d41d249add830/poster_1765189493531.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6936a741843d41d249add830/screenshot4_3_1765189493531.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6936a741843d41d249add830/screenshot16_9_1765189493531.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"692ef100d52ea9e4858e06b9"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6936a741843d41d249add830/poster16_9_1765189493531.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Debi Derryberry","Larissa Gallagher","Cristina M. Medina"],"directors":["Dan Fraga","Villads Spangsberg"],"originalReleaseDate":"2017-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6936a741843d41d249add830/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"6203772d22dc3f0013dd9a0c-fr":{"_id":"6203772d22dc3f0013dd9a0c","seriesID":"6203772c22dc3f0013dd9a05","slug":"sabrina-friends-forever-fr-2001-1-1","name":"Sabrina au royaume des sorcières","summary":"Sabrina part à l’école des sorcières, mais elle cache un secret qui lui fait craindre de se faire rejeter : elle est mi-sorcière, mi-mortelle. Sabrina pourra-t-elle faire ses preuves aux yeux de ses profs, de ses camarades et d’elle-même ?","description":"Sabrina part à l’école des sorcières, mais elle cache un secret qui lui fait craindre de se faire rejeter : elle est mi-sorcière, mi-mortelle. Sabrina pourra-t-elle faire ses preuves aux yeux de ses profs, de ses camarades et d’elle-même ?","duration":4920000,"originalContentDuration":4245000,"allotment":4920,"rating":"P","featuredImage":{"path":"https://images.pluto.tv/episodes/6203772d22dc3f0013dd9a0c/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Children & Family","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6203772d22dc3f0013dd9a0c/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6203772d22dc3f0013dd9a0c/poster.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6203772d22dc3f0013dd9a0c/screenshot4_3.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6203772d22dc3f0013dd9a0c/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"692ef100d52ea9e4858e06b9"},{"id":"675183db3a61d40008c45824"}],"kidsMode":true,"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"originalReleaseDate":"2002-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6203772d22dc3f0013dd9a0c/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"694a80090c94b060783a5456-fr":{"_id":"694a80090c94b060783a5456","seriesID":"694a80080c94b060783a5439","slug":"max-steel-movie-1-the-wrath-of-makino-301-302-2014-1-1","name":"Max Steel: The Wrath of Makino","summary":"Makino, le dévoreur de mondes, revient ! Son cœur maléfique vit encore, appelant les UltraLinks à réclamer son pouvoir. Max Steel doit les arrêter — son nouveau mode Turbo Nova suffira-t-il à vaincre Makino ?","description":"Makino — le dévoreur de mondes ! Comment est-ce possible ? La dernière fois que nous avons vu Makino, il avait été réduit en miettes dans l’orbite terrestre par Max Steel ! Mais le cœur maléfique de Makino bat encore — littéralement ! — appelant ses derniers UltraLinks — comme les Elementors, Prism, Blast, et même Steel ! — à devenir son héritier et à revendiquer son immense pouvoir. L’esprit maléfique de Makino possédera quiconque touchera son cœur le premier ! Et Max Steel se lance dans une course contre la montre pour les arrêter ! Le nouveau mode Turbo Nova de Max sera-t-il suffisant pour vaincre un Makino ressuscité ?","duration":2773000,"originalContentDuration":2593000,"allotment":2773,"rating":"P","featuredImage":{"path":"https://images.pluto.tv/episodes/694a80090c94b060783a5456/screenshot16_9_1766541455282.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Children & Family","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/694a80090c94b060783a5456/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/694a80090c94b060783a5456/poster_1766541455282.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/694a80090c94b060783a5456/screenshot4_3_1766541455282.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/694a80090c94b060783a5456/screenshot16_9_1766541455282.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"692ef18e1cbb941e52208f43"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/694a80090c94b060783a5456/poster16_9_1766541455282.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Andrew Francis","Sam Vincent","Trevor Devall"],"directors":["Jeremy Brown","Barry Karnowski"],"originalReleaseDate":"2015-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/694a80090c94b060783a5456/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"694a887f287ec44e14ddb6bd-fr":{"_id":"694a887f287ec44e14ddb6bd","seriesID":"694a887e287ec44e14ddb6a0","slug":"max-steel-movie-2-the-dawn-of-morphos-303-304-2014-1-1","name":"Max Steel: The Dawn of Morphos","summary":"Morphos, une créature monstrueuse créée par Miles Dread, peut copier les pouvoirs de ses ennemis ! Pour le vaincre, Max et Steel lancent le Duo-Strike — deux modes Turbo combinés pour une puissance doublée !","description":"Qui est Morphos ? C’est une créature terrifiante, un véritable patchwork — un Frankenstein ! — composée de multiples morceaux de monstres recousus ensemble, créée par Miles Dread pour détruire Max Steel une fois pour toutes ! Morphos peut copier les pouvoirs de quiconque l’affronte et les faire siens ! Comment combattre un ennemi capable d’utiliser vos propres pouvoirs contre vous ? En le frappant avec plus de puissance qu’il ne peut en supporter ! Pour Max et Steel, cela signifie le DUO-STRIKE ! Un nouveau style de combat impressionnant où ils combinent deux de leurs modes Turbo en même temps pour obtenir une puissance Turbo extrême ! Double mode, double puissance ! Frapper Morphos avec deux modes à la fois pourrait bien donner à Max et Steel l’avantage dont ils ont besoin pour le renverser et l’éliminer !","duration":2773000,"originalContentDuration":2593000,"allotment":2773,"rating":"P","featuredImage":{"path":"https://images.pluto.tv/episodes/694a887f287ec44e14ddb6bd/screenshot16_9_1766513324716.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Children & Family","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/694a887f287ec44e14ddb6bd/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/694a887f287ec44e14ddb6bd/poster_1766513324716.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/694a887f287ec44e14ddb6bd/screenshot4_3_1766513324716.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/694a887f287ec44e14ddb6bd/screenshot16_9_1766513324716.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"692ef18e1cbb941e52208f43"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/694a887f287ec44e14ddb6bd/poster16_9_1766513324716.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Andrew Francis","Sam Vincent","Nicole Oliver"],"directors":["Andrew Doucette","Ben Anderson"],"originalReleaseDate":"2015-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/694a887f287ec44e14ddb6bd/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"694a887c287ec44e14dd40a6-fr":{"_id":"694a887c287ec44e14dd40a6","seriesID":"694a887a287ec44e14dd4089","slug":"max-steel-movie-3-maximum-morphos-323-324-2014-1-1","name":"Max Steel : Maximum Morphos","summary":"Après leur victoire sur Morphos, Max et Steel découvrent de nouveaux modes Duo-Strike. Mais Morphos revient, plus puissant, capable de copier plusieurs pouvoirs ! Pour le vaincre, ils doivent s’allier à leurs ennemis… puis les affronter !","description":"Tout juste victorieux contre Morphos, la vie semble plutôt belle pour Max et Steel. Ils ont même découvert de nouveaux modes Duo-Strike, comme le Turbo Vol Sonique ! Et c’est une bonne chose, car ils vont en avoir besoin. Morphos est de retour, plus fort que jamais ! Pour prouver qu’il est le plus grand des méchants, Morphos entreprend de copier les pouvoirs de tous les ennemis de Dread : Elementor, Tozxon, et même Dread lui-même, un par un. Et bien sûr, celui de Max Steel aussi ! Pire encore, Morphos a appris à copier le Duo-Strike ! Il peut désormais manier plusieurs pouvoirs à la fois ! Pour vaincre Morphos une bonne fois pour toutes, Max et Steel doivent accomplir l’impensable : s’allier à leurs ennemis, tout en sachant que, même s’ils gagnent, ces derniers se retourneront contre eux dès que Morphos sera vaincu ! Max et Steel doivent donc se préparer à affronter TOUS leurs adversaires.","duration":2773000,"originalContentDuration":2593000,"allotment":2773,"rating":"P","featuredImage":{"path":"https://images.pluto.tv/episodes/694a887c287ec44e14dd40a6/screenshot16_9_1766492290486.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Children & Family","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/694a887c287ec44e14dd40a6/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/694a887c287ec44e14dd40a6/poster_1766492290486.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/694a887c287ec44e14dd40a6/screenshot4_3_1766492290486.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/694a887c287ec44e14dd40a6/screenshot16_9_1766492290486.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"692ef18e1cbb941e52208f43"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/694a887c287ec44e14dd40a6/poster16_9_1766492290486.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Andrew Francis","Sam Vincent","Brian Dobson"],"directors":["Andrew Doucette","Ben Anderson","Barry Karnowski"],"originalReleaseDate":"2015-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/694a887c287ec44e14dd40a6/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb