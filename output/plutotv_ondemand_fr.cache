lur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"66d9b6d2cb8890000854aa28"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"originalReleaseDate":"2015-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/649933439263a40013de2a39/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9.._iMjhXzd5myxTxHJjJBgZ58AHeIA8ggQdafWrKz0vdQ&masterJWTPassthrough=true"},"60239d3117f370001a3f0372-fr":{"_id":"60239d3117f370001a3f0372","seriesID":"60239d3117f370001a3f036c","slug":"asias-deadliest-snakes-fr-2009-1-1","name":"Face aux serpents tueurs","summary":"Chaque année, en Asie, plus de 100 000 personnes meurent des suites d'une morsure de serpent. Le docteur Bryan Fry, spécialiste des venins, emmène le téléspectateur à travers l'Asie, à la découverte des dix serpents les plus dangereux.","description":"Chaque année, en Asie, plus de 100 000 personnes meurent des suites d'une morsure de serpent. Le docteur Bryan Fry, spécialiste des venins, emmène le téléspectateur à travers l'Asie, à la découverte des dix serpents les plus dangereux.\nTrois types de toxines peuvent composer le venin : les premières s'attaquent au sang et au coeur, les deuxièmes à la peau et aux chairs, et les dernières au système nerveux.\nMais les serpents adaptent leur arme à leurs proies et sont habituellement inoffensifs pour les humains.\nPlusieurs serpents très dangereux n'attaquent qu'en cas de danger imminent et chercheraient plutôt à fuir l'homme.\nMais avec l'augmentation de la population dans certaines parties de l'Asie, les rencontres sont de plus en plus inévitables...","duration":3480000,"originalContentDuration":3000000,"allotment":3480,"rating":"10","featuredImage":{"path":"https://images.pluto.tv/episodes/60239d3117f370001a3f0372/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/60239d3117f370001a3f0372/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/60239d3117f370001a3f0372/poster.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/60239d3117f370001a3f0372/screenshot4_3.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/60239d3117f370001a3f0372/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"66d9b6d2cb8890000854aa28"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"actors":["DR. BRYAN GRIEG FRY"],"directors":["JOHN RUTHVEN"],"originalReleaseDate":"2010-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/60239d3117f370001a3f0372/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=50.6900&deviceLon=3.1800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=FR&serverSideAds=true&sessionID=25e2c113-d506-11f1-bac0-c60fe4c6689c&sid=25e2c113-d506-11f1-bac0-c60fe4c6689c&userId=&