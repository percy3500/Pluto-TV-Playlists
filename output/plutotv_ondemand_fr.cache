éliorer le traitement des patients mentaux dans les hôpitaux, elle rencontre une femme qui se donnera pour mission de transformer la vie de bourreau de travail de Colette.","duration":7123000,"originalContentDuration":6583000,"allotment":7123,"rating":"10","featuredImage":{"path":"https://images.pluto.tv/episodes/6a22bfe80aef1275c63c9ac3/screenshot16_9_1780662261730.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Drama","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6a22bfe80aef1275c63c9ac3/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6a22bfe80aef1275c63c9ac3/poster_1780662261730.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6a22bfe80aef1275c63c9ac3/screenshot4_3_1780662261730.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6a22bfe80aef1275c63c9ac3/screenshot16_9_1780662261730.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6074608bb672c30007b43258"},{"id":"5fd381616d048500077abd3e"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6a22bfe80aef1275c63c9ac3/poster16_9_1780662261730.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Helena Bonham Carter","Hilary Swank","Jeffrey Tambor.","Cynthia Hoppenfeld","Edward Bennett","Florence Bell","Johan Heldenbergh","Jeffrey Tambor","Vincent Riotta","Doreen Mantle"],"directors":["Bille August"],"producers":["Anita Elsani","Lesley Bruce-Neary","Iman Khatibzadeh"],"originalReleaseDate":"2017-09-17T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6a22bfe80aef1275c63c9ac3/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=FR&deviceDNT=false&deviceId=688e2