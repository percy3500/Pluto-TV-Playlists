 del mundo del bodybuilding, Arnold Schwarzenegger actúa en este documental sobre los 100 días previos al concurso de Mr. Olympia de 1975.","duration":6055000,"originalContentDuration":5155000,"allotment":6055,"rating":"TP","featuredImage":{"path":"https://images.pluto.tv/episodes/69eb479124d9b7beb513dfbc/screenshot16_9_1777037123266.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/69eb479124d9b7beb513dfbc/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/69eb479124d9b7beb513dfbc/poster_1777037114925.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/69eb479124d9b7beb513dfbc/screenshot4_3_1777026962061.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/69eb479124d9b7beb513dfbc/screenshot16_9_1777037123266.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6a43a98afa7175aa698b287b"},{"id":"62d949808f6f0d00079962aa"},{"id":"5f68837015c9a300077f1b3d"},{"id":"5f71aae661e66d0007dc3eee"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/69eb479124d9b7beb513dfbc/poster16_9_1777026962061.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Arnold Schwarzenegger","Lou Ferrigno","Matty Ferrigno","Victoria Ferrigno","Mike Katz","Franco Columbu","Ed Corney","Ken Waller","Serge Nubret","Robbie Robinson"],"directors":["George Butler","Robert Fiore"],"producers":["George Butler","Jerome Gary"],"originalReleaseDate":"1978-03-31T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/69eb479124d9b7beb513dfbc/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=ES&deviceDNT=false