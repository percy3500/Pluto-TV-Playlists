:"6a43a98afa7175aa698b287b"},{"id":"5f68837015c9a300077f1b3d"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/61ea6dd8161b65001a9c2b37/poster16_9_1779319081434.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Charlie Sheen","Martin Sheen","Laurence Fishburne","Michael Beach","Ramon Estevez"],"directors":["Martin Sheen"],"writers":["Dennis Shryack"],"producers":["Richard Davis"],"originalReleaseDate":"1991-02-15T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/61ea6dd8161b65001a9c2b37/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=ES&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=40.4200&deviceLon=-3.6800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=ES&serverSideAds=true&sessionID=694ac3ee-d503-11f1-8ea9-aa0149cc1ea4&sid=694ac3ee-d503-11f1-8ea9-aa0149cc1ea4&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..Dp3o-iPYE533J881KpUSpugJiqZPBQ5AQh1OL8zHfEo&masterJWTPassthrough=true"},"6970a947b06fa36c2b679e13-es":{"_id":"6970a947b06fa36c2b679e13","seriesID":"6970a945b06fa36c2b679df3","slug":"death-note-2006-1-1","name":"Death Note","summary":"El brillante estudiante Light Yagami encuentra un \"Death Note\" con el que, asistido por el Shinigami Ryuk, decide matar criminales. Su plan se tuerce cuando L, un genio detective, inicia una cacería para descubrir su identidad.","description":"Light Yagami es un joven y brillante estudiante que un día encuentra un cuaderno llamado \"Death Note\" con poderes sobrenaturales que matan a todo aquel cuyo nombre sea escrito en él. Acompañado por el Shinigami (Dios de la Muerte) de la \"Death Note\", de nombre Ryuk, Light decide iniciar una misión para librar al mundo de todos los criminales. Pero su plan empezará a torcerse cuando L, un detective con una mente superdotada, decida descifrar el misterio que rodea a todas estas muertes.","duration":8001000,"originalContentDuration":7281000,"allotment":8001,"rating":"+12","featuredImage":{"path":"https://images.pluto.tv/episodes/6970a947b06fa36c2b679e13/screenshot16_9_1777924441480.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Anime","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6970a947b06fa36c2b679e13/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6970a947b06fa36c2b679e13/poster_1777924441480.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6970a947b06fa36c2b679e13/screenshot4_3_1777924441480.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6970a947b06fa36c2b679e13/screenshot16_9_1777924441480.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"6a43a9a2a24c5f45210e0fd5"},{"id":"60a244895950930007c24202"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6970a947b06fa36c2b679e13/poster16_9_1777924441480.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Mamoru Miyano","Brad Swaile","Vincent Tong"],"directors":["Shunsuke Kaneko"],"originalReleaseDate":"2006-06-17T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6970a947b06fa36c2b679e13/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=ES&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=40.4200&deviceLon=-3.6800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=ES&serverSideAds=true&sessionID=694ac3ee-d5