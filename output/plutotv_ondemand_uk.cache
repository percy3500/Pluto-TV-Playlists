eid"],"originalReleaseDate":"2014-01-25T00:00:00Z"},"avail":{},"cc":true,"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/69dcc1713f22a165b0fae78d/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"614830ecbce9e900135b559d-uk":{"_id":"614830ecbce9e900135b559d","seriesID":"614830eabce9e900135b5597","slug":"witch-hunt-in-salem-2016-1-1","name":"Witch Hunt in Salem","summary":"New England, 1692: religious hysteria infects the people of small-town Salem. One of the darkest chapters in the US history that fascinates scholars, artists and general public to this...","description":"New England, 1692: religious hysteria infects the people of small-town Salem. One of the darkest chapters in the US history that fascinates scholars, artists and general public to this day as the cause of the collective mania remains a mystery.","duration":3480000,"originalContentDuration":3120000,"allotment":3480,"rating":"15+","featuredImage":{"path":"https://images.pluto.tv/episodes/614830ecbce9e900135b559d/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/614830ecbce9e900135b559d/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/614830ecbce9e900135b559d/poster.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/614830ecbce9e900135b559d/screenshot4_3.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/614830ecbce9e900135b559d/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5c5bf751f21b553c1f673ad6"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/614830ecbce9e900135b559d/poster16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"directors":["Wolf Truchsess von Wetzhausen","Felicitas Hammerstein","Mariana Schneider"],"originalReleaseDate":"2017-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/614830ecbce9e900135b559d/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"626f85e273a0a1001450a843-uk":{"_id":"626f85e273a0a1001450a843","seriesID":"626f85e173a0a1001450a83c","slug":"crime-scene-eulau-the-mystery-of-the-13-skeletons-2010-1-1","name":"Crime Scene Eulau - The Mystery of the 13 Skeletons","summary":"This documentary focuses on a spectacular discovery made in a quarry near the village of Eulau, not far from the central German town of Naumburg.","description":"This documentary focuses on a spectacular discovery made in a quarry near the village of Eulau, not far from the central German town of Naumburg. Neolithic graves contained the skeletons of three women, two men and eight children, buried tenderly 4500 years ago, some affectionately entwined. In 2008, for the first time anywhere in the world, it was possible to perform a DNA analysis on the earliest evidence of the existence of a nuclear family. This was a sensation - but why did these people all die at the same time? Were they the victims of a violent crime? Who were they, and how did this terrible drama unfold? Archaeologists insist that these victims will not be forgotten, since these days it is possible to do far more than simply date and record such finds. Modern scientific methods have revolutionised archaeology, enabling us to discover how and why the family from Eulau in the German state of Sachsen-Anhalt died 4500 years ago. By enlisting the help of a CID profiler, archaeologists and anthropologists employ state-of-the-art analytical methods to investigate this Stone Age crime. In the process we discover key information about an era before recorded history which has previously been shrouded in mystery - and astonishing information about the composition of the population here also comes to light. It seems that the third millennium before Christ saw two major waves of migration, from Eastern and Western Europe, which determine the composition of the population here. In the middle of what is now Germany these two migratory movements met. Could this be the background to the mysterious murders of Eulau?","duration":3000000,"originalContentDuration":2640000,"allotment":3000,"rating":"12+","featuredImage":{"path":"https://images.pluto.tv/episodes/626f85e273a0a1001450a843/screenshot16_9_1787009762165.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/626f85e273a0a1001450a843/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/626f85e273a0a1001450a843/poster_1787009762165.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/626f85e273a0a1001450a843/screenshot4_3_1787009762165.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/626f85e273a0a1001450a843/screenshot16_9_1787009762165.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5c5bf751f21b553c1f673ad6"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/626f85e273a0a1001450a843/poster16_9_1787009762165.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"directors":["Gerwin Dahm"],"writers":["Michael Gregor","Gerwin Dahm"],"producers":["neue deutsche Filmgesellschaft mbH"],"originalReleaseDate":"2010-08-28T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/626f85e273a0a1001450a843/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"61482fc1766f2a0014302daf-uk":{"_id":"61482fc1766f2a0014302daf","seriesID":"61482fc0766f2a0014302da9","slug":"garibaldi-freedom-fighter-and-womanizer-2017-1-1","name":"Garibaldi - Freedom Fighter and Womanizer","summary":"He was one of the 19th century's most important revolutionaries, an architect of Italian unity and a popular ladies' man: Giuseppe Garibaldi. With the help of descendants and historians,...","description":"He was one of the 19th century's most important revolutionaries, an architect of Italian unity and a popular ladies' man: Giuseppe Garibaldi. With the help of descendants and historians, the film investigates a man of many legends and contradictions.","duration":3480000,"originalContentDuration":3120000,"allotment":3480,"rating":"15+","featuredImage":{"path":"https://images.pluto.tv/episodes/61482fc1766f2a0014302daf/screenshot16_9_1786137122321.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/61482fc1766f2a0014302daf/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/61482fc1766f2a0014302daf/poster_1786137122321.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/61482fc1766f2a0014302daf/screenshot4_3_1786137122320.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/61482fc1766f2a0014302daf/screenshot16_9_1786137122321.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5c5bf751f21b553c1f673ad6"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/61482fc1766f2a0014302daf/poster16_9_1786137122321.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"directors":["Martin Betz"],"originalReleaseDate":"2018-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/61482fc1766f2a0014302daf/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&