.tv/v2/stitch/hls/episode/6a44fe74925ff998a6ff0a95/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"6a44d1766fa8553af9d52862-uk":{"_id":"6a44d1766fa8553af9d52862","seriesID":"6a44d1766fa8553af9d52843","slug":"spaceways-1953-1-1","name":"Spaceways","summary":"When a British rocket scientist is accused of murdering his wife, he must journey into space to prove his innocence.","description":"A British rocket scientist is accused of murdering his wife and her Soviet lover, then disposing of the evidence by shooting their remains into space. Now, the only way to prove his innocence is to venture out there himself on a cold, cold journey, accompanied only by a lovely fellow scientist who is guaranteed to keep things warm.","duration":5320000,"originalContentDuration":4600000,"allotment":5320,"rating":"All","featuredImage":{"path":"https://images.pluto.tv/episodes/6a44d1766fa8553af9d52862/screenshot16_9_1782894968143.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Sci-Fi & Fantasy","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6a44d1766fa8553af9d52862/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6a44d1766fa8553af9d52862/poster_1782894968143.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6a44d1766fa8553af9d52862/screenshot4_3_1782894968143.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6a44d1766fa8553af9d52862/screenshot16_9_1782894968143.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5bc7591f62ba3220efe57cef"},{"id":"66ec3b4c18a3c00008a932e6"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6a44d1766fa8553af9d52862/poster16_9_1782894968143.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Howard Duff","Eva Bartok","Alan Wheatley","Philip Leaver","Michael Medwin","Andrew Osborn","Cecile Chevreau","Anthony Ireland","Hugh Moxey","David Horne"],"directors":["Terence Fisher"],"producers":["Michael Carreras"],"originalReleaseDate":"1953-06-24T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6a44d1766fa8553af9d52862/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"6a44cbd10bd9448d81861e80-uk":{"_id":"6a44cbd10bd9448d81861e80","seriesID":"6a44cbd00bd9448d81861e60","slug":"hustlers-convention-2015-1-1","name":"Hustlers Convention","summary":"The story of Sport and Spoon - two young hustlers who attend the eponymous convention, only to get tangled up in a financial disagreement that leads to a shootout, police chase and finishes with Sport on Death Row","description":"Released in 1973 by founding member of The Last Poets, Jalal Nuriddin, under the name Lightnin' Rod, Hustlers Convention tells the story of Sport and Spoon - two young hustlers who attend the eponymous convention, only to get tangled up in a financial disagreement that leads to a shootout, police chase and finishes with Sport on Death Row, weighing up what it all means.\nTaking its title from the album, Hustlers Convention the film will blend archive and photos with interviews and use unique animated sequences set tot he album. We will see the Hustlers Convention in its wider social context and Jalal's personal story as one of rap's undisputed pioneers","duration":6467000,"originalContentDuration":5507000,"allotment":6467,"rating":"15+","featuredImage":{"path":"https://images.pluto.tv/episodes/6a44cbd10bd9448d81861e80/screenshot16_9_1782893522515.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6a44cbd10bd9448d81861e80/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6a44cbd10bd9448d81861e80/poster_1782893522515.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6a44cbd10bd9448d81861e80/screenshot4_3_1782893522515.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6a44cbd10bd9448d81861e80/screenshot16_9_1782893522515.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5bc7591f62ba3220efe57cef"},{"id":"696902734b352fda700bdc05"},{"id":"62a710ce41b0910007c2691c"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6a44cbd10bd9448d81861e80/poster16_9_1782893522515.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"directors":["Mike Todd"],"producers":["Geseth Garcia","Lathan Hodge","Quenell Jones"],"originalReleaseDate":"2015-12-08T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6a44cbd10bd9448d81861e80/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"6a44ca697a3bd954b7c844d1-uk":{"_id":"6a44ca697a3bd954b7c844d1","seriesID":"6a44ca687a3bd954b7c844b2","slug":"hurricane-2018-1-1","name":"Hurricane","summary":"HURRICANE tells the story of the Polish fliers who found themselves fighting for the freedom of their own country in foreign skies.","description":"HURRICANE tells the story of the Polish fliers who found themselves fighting for the freedom of their own country in foreign skies. Seen through the eyes of Jan Zumbach (Rheon), fighter ace and adventurer, it tells how the Poles, driven across Europe by the German war machine, finally made their last stand. Flying Hurricanes for the RAF over Britain, they became a key component in the legend of 'The Few'. Up against the might of the Luftwaffe they hoped that, by saving Great Britain from Nazi invasion, they were keeping the dream of a free Poland alive. In the lethal melee above England in that summer of 1940, they fought with a tenacity and skill that earned them the admiration of the whole British nation. The dogfights against superior planes cost some of the men their lives. The constant strain of gladiatorial combat took away the sanity of others. But, as Zumbach discovers as the war stutters to a close, becoming the best in the RAF is a hollow victory for the Poles. This powerful and gripping WWII RAF story is directed by David Blair (The Messenger, Away, Accused) and includes an impressive ensemble cast including Iwan Rheon (Game of Thrones, Marvel's Inhumans), Milo Gibson (Hacksaw Ridge), Stefanie Martini (Crooked House, Prime Suspect 1973), Krystof Hadek (Under the Skin, Dark Blue World) and Marcin Dorocinski (Pitbull Anthropoid).","duration":7537000,"originalContentDuration":6457000,"allotment":7537,"rating":"15+","featuredImage":{"path":"https://images.pluto.tv/episodes/6a44ca697a3bd954b7c844d1/screenshot16_9_1782893162577.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Action & Adventure","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6a44ca697a3bd954b7c844d1/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6a44ca697a3bd954b7c844d1/poster_1782893162577.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6a44ca697a3bd954b7c844d1/screenshot4_3_1782893162577.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6a44ca697a3bd954b7c844d1/screenshot16_9_1782893162577.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5bc7591f62ba3220efe57cef"},{"id":"66e2f3b15b8ec0000881ad75"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6a44ca697a3bd954b7c844d1/poster16_9_1782893162577.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Iwan Rheon","Milo Gibson","Stefanie Martini"],"directors":["David Blair"],"originalReleaseDate":"2018-09-07T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6a44ca697a3bd954b7c844d1/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a