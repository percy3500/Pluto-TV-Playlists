ngRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"626f85b373a0a100145074c7-uk":{"_id":"626f85b373a0a100145074c7","seriesID":"626f85b173a0a100145074c0","slug":"orient-express-a-train-writes-history-2020-1-1","name":"Orient Express – A Train Writes History","summary":"Putting the Orient Express - also called “the train of trains” - on its tracks called for considerable stamina.","description":"Putting the Orient Express - also called “the train of trains” - on its tracks called for considerable stamina. Several times, the ambitious project of Georges Nagelmackers was on the brink of failure as the Belgian entrepreneur was facing the bankruptcy of his sleeping car company, the Compagnie International des Wagons-Lits (CIWL). Yet, he kept on striving for his goal - to link Europe’s capitals by a network of night trains.","duration":4020000,"originalContentDuration":3540000,"allotment":4020,"rating":"9+","featuredImage":{"path":"https://images.pluto.tv/episodes/626f85b373a0a100145074c7/screenshot16_9_1766529363440.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/626f85b373a0a100145074c7/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/626f85b373a0a100145074c7/poster_1766529363439.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/626f85b373a0a100145074c7/screenshot4_3_1766529363440.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/626f85b373a0a100145074c7/screenshot16_9_1766529363440.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"696902734b352fda700bdc05"},{"id":"5c5bf751f21b553c1f673ad6"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"actors":["Nicole Engeln","Nick Bolton"],"directors":["Gerhard Rekel"],"writers":["Gerhard Rekel"],"producers":["Svenja Wolter","Jana Asmuth"],"originalReleaseDate":"2020-04-07T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/626f85b373a0a100145074c7/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"626f858073a0a10014503416-uk":{"_id":"626f858073a0a10014503416","seriesID":"626f857e73a0a1001450340f","slug":"in-search-of-santa-claus-2006-1-1","name":"In Search of Santa Claus","summary":"He's one of the most widely recognized figures in the world; but what are the origins of St. Nicholas, and how did he become Santa Claus?","description":"The amazing transformation of a holy man from Turkey into the world-wide symbol of Christmas cheer. He's one of the most widely recognized figures in the world; but what are the origins of St. Nicholas, and how did he become Santa Claus? With criminological acumen, this one-hour documentary sorts the myths from the facts to present the true story of the first multi-national saint, revered by the Catholic, Protestant and Orthodox churches alike. Two historical figures staked a claim to be the original Nicholas: the fourth-century miracle worker, Bishop Nicholas of Myra (in today's Turkey), and the sixth-century Abbot Nicholas of nearby Sion. The bishop's bones, however, were in Myra, which makes a clear case for the miracle worker. Loved for his deeds and miracles, Nicholas came to be portrayed on icons. When one was brought to Western Europe in 972 by a Byzantine princess, Nicholas suddenly became a European celebrity – a Nicholas icon was a must-have in the best households. And don’t we still call celebrities \"icons\" today?","duration":3480000,"originalContentDuration":3000000,"allotment":3480,"rating":"9+","featuredImage":{"path":"https://images.pluto.tv/episodes/626f858073a0a10014503416/screenshot16_9_1786737243604.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/626f858073a0a10014503416/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/626f858073a0a10014503416/poster_1786737243604.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/626f858073a0a10014503416/screenshot4_3_1786737243604.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/626f858073a0a10014503416/screenshot16_9_1786737243604.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"696902734b352fda700bdc05"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/626f858073a0a10014503416/poster16_9_1786737243604.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Andrew Solomon"],"directors":["Martin Papirowski"],"writers":["Martin Papirowski","Heike Nelsen-Minkenberg"],"producers":["Martin Papirowski"],"originalReleaseDate":"2006-12-24T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/626f858073a0a10014503416/master.m3u8?advertisingId=&a