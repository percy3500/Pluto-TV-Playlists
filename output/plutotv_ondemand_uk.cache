=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/5df2b97bd7296f54ff1e3703/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5c5bf751f21b553c1f673ad6"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/5df2b97bd7296f54ff1e3703/poster16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"directors":["Andreas SawallSaskia Weisheit"],"writers":["Andreas Sawall"],"producers":["Spiegel TV GmbH"],"originalReleaseDate":"2011-08-13T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/5df2b97bd7296f54ff1e3703/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"5ff3396a05630c001a2e6832-uk":{"_id":"5ff3396a05630c001a2e6832","seriesID":"5ff3396905630c001a2e682a","slug":"the-truth-about-franco-spains-forgotten-dictatorship-special-2017-1-1","name":"The Truth about Franco - Spain's forgotten Dictatorship (Special)","summary":"The victor in a bloody civil war, Francisco Franco seized power and ruled Spain with an iron hand for nearly four decades. “The Truth About Franco” casts new light on the Franco era.","description":"Francisco Franco is regarded by many as one of the most brutal dictators in European history. Spain is marked by traces of his tyranny even today and the Spanish Civil War and nearly forty years of Francoist dictatorship are overshadowed by many open questions. What really happened back then? Who was the man who still divides Spain today? What induced young people from all over the world to take part in the Spanish Civil War? How was life in the dictatorship at all possible? On the basis of the latest research findings, “The Truth About Franco” casts new light on “Spain's Forgotten Dictatorship”.","duration":3660000,"originalContentDuration":3135000,"allotment":3660,"rating":"12+","featuredImage":{"path":"https://images.pluto.tv/episodes/5ff3396a05630c001a2e6832/screenshot16_9_1789155002911.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/5ff3396a05630c001a2e6832/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/5ff3396a05630c001a2e6832/poster_1789155002911.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/5ff3396a05630c001a2e6832/screenshot4_3_1789155002911.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/5ff3396a05630c001a2e6832/screenshot16_9_1789155002911.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5c5bf751f21b553c1f673ad6"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/5ff3396a05630c001a2e6832/poster16_9_1789155002911.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Steve Tipping"],"directors":["Klaus Kastenholz"],"producers":["Dagmar Rosenbauer","Stefan Bomhof"],"originalReleaseDate":"2017-12-31T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/5ff3396a05630c001a2e6832/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0