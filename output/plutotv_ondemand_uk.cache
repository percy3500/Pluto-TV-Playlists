/5ba890e747c9d316dda1d146/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"5bca16d1ed3fa8a14743df43-uk":{"_id":"5bca16d1ed3fa8a14743df43","seriesID":"5bca16d0ed3fa8a14743df41","slug":"2020-nostradamus-1-1-ptv1","name":"2020 Nostradamus","summary":"Nostradamus predicted the rise of Hitler, the nuclear destruction of Hiroshima and 9/11. New research reveals further predictions that indicate more peril is on the horizon.","description":"Nostradamus predicted the rise of Hitler, the nuclear destruction of Hiroshima and 9/11. New research reveals further predictions that indicate more peril is on the horizon.","duration":4620000,"originalContentDuration":4020000,"allotment":4620,"rating":"15","featuredImage":{"path":"https://images.pluto.tv/episodes/5bca16d1ed3fa8a14743df43/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/5bca16d1ed3fa8a14743df43/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/5bca16d1ed3fa8a14743df43/poster.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/5bca16d1ed3fa8a14743df43/screenshot4_3.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/5bca16d1ed3fa8a14743df43/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5c5bf751f21b553c1f673ad6"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/5bca16d1ed3fa8a14743df43/poster16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Paul Hughes","Razor Keeves"],"directors":["Phillip Gardiner"],"producers":["Phillip Gardiner"],"originalReleaseDate":"2018-02-26T00:00:00Z"},"avail":{},"cc":true,"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/5bca16d1ed3fa8a14743df43/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"5fa91cc2e5d584001a90dd8d-uk":{"_id":"5fa91cc2e5d584001a90dd8d","seriesID":"5fa91cc1e5d584001a90dd87","slug":"osama-bin-laden-up-close-and-personal-2015-1-1","name":"Osama Bin Laden - Up Close and Personal","summary":"Recovered private documents offer new insights into the last years of Bin Laden’s life.","description":"Just after midnight on May 2, 2011, United States Special Forces raided the compound in Abbottabad, Pakistan, where Osama Bin laden had been hiding for years. “America’s public enemy number one” was killed during the operation. The Navy SEALs thoroughly searched his house, recovering everything that could provide information about Bin Laden and his terrorist network Al-Qaeda: His documents and private correspondence, as well as every electronic data carrier. Analysts from the CIA and other US secret services immediately started working on evaluating these “Bin Laden-papers”. In America’s War on Terrorism, any detail mattered and could hold clues to the enemy’s character and to the threat that Al-Qaeda still posed. In May of 2015, the „Office of the Director of National Intelligence” made available to the public parts of the recovered “Bin Laden-papers”. This documentary analyzes these materials, allowing new perspectives on the terrorist leader, on the story of his life; especially on the private life, he led in his last years. The man spent those years in Abbottabad with hardly any freedom of movement. His compound in Abbottabad, which was apparently supposed to offer him safety from the Americans, was a kind of prison – albeit one that he chose for himself. It is where Bin Laden lived with most of his family. Bin Laden’s sphere of influence was extremely limited; he was left with hardly anything but his computer – for security reasons there was no internet and no telephone. Osama Bin Laden read a lot and followed the news via TV and BBC-Radio. Couriers had to deliver his messages to the outside world in envelopes and on USB thumb drives. As a leader and symbolic figure, however, he still played a major role – to his followers as well as to his enemies.","duration":3540000,"originalContentDuration":3045000,"allotment":3540,"rating":"9+","featuredImage":{"path":"https://images.pluto.tv/episodes/5fa91cc2e5d584001a90dd8d/screenshot16_9_1785436562551.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/5fa91cc2e5d584001a90dd8d/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/5fa91cc2e5d584001a90dd8d/poster_1785436562551.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/5fa91cc2e5d584001a90dd8d/screenshot4_3_1785436562551.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/5fa91cc2e5d584001a90dd8d/screenshot16_9_1785436562551.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5c5bf751f21b553c1f673ad6"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/5fa91cc2e5d584001a90dd8d/poster16_9_1785436562551.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Nick Benjamin","Peter Bergen","Steve Coll","Guido Steinberg","Greg Miller","Shaukat Qadir"],"directors":["Alexander Berkel"],"writers":["Alexander Berkel"],"producers":["ZDF","Carola Ulrich","Achim Seegebrecht"],"originalReleaseDate":"2015-12-30T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/5fa91cc2e5d584001a90dd8d/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"61b08dd6c323f20013e6a2c7-uk":{"_id":"61b08dd6c323f20013e6a2c7","seriesID":"61b08dd4c323f20013e6a2c1","slug":"breaking-habits-2018-1-1","name":"Breaking Habits","summary":"An outrageous, not-to-be-missed documentary about a Sisterhood of gun-slinging nuns who live and work in a modern day Wild West.","description":"An outrageous, not-to-be-missed documentary about a Sisterhood of gun-slinging nuns who live and work in a modern day Wild West.","duration":5940000,"originalContentDuration":5265000,"allotment":5940,"rating":"15+","featuredImage":{"path":"https://images.pluto.tv/episodes/61b08dd6c323f20013e6a2c7/screenshot16_9_1766008444695.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/61b08dd6c323f20013e6a2c7/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/61b08dd6c323f20013e6a2c7/poster_1766008444695.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/61b08dd6c323f20013e6a2c7/screenshot4_3_1766008444695.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/61b08dd6c323f20013e6a2c7/screenshot16_9_1766008444695.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5c5bf751f21b553c1f673ad6"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/61b08dd6c323f20013e6a2c7/poster16_9_1766008444695.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Sister Kate"],"originalReleaseDate":"2019-01-01T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/61b08dd6c323f20013e6a2c7/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"5df2b92bd7296f54ff1e3659-uk":{"_id":"5df2b92bd7296f54ff1e3659","seriesID":"5df2b8f3d7296f54ff1e3638","slug":"the-lost-city-of-the-cloud-people-2010-1-1","name":"The Lost City of the Cloud People","summary":"One of the most fascinating metropolises in the history of mankind is hidden deep in the remote jungle up in Peru’s highlands. The Inca referred to them as Warriors of the Clouds as their city high in the mountains did almost reach the sky.","description":"One of the most fascinating metropolises in the history of mankind is hidden deep in the remote jungle up in Peru’s highlands. The Inca referred to them as Warriors of the Clouds as their city high in the mountains did almost reach the sky.","duration":3180000,"originalContentDuration":2640000,"allotment":3180,"rating":"9+","featuredImage":{"path":"https://images.pluto.tv/episodes/5df2b92bd7296f54ff1e3659/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/5df2b92bd7296f54ff1e3659/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/5df2b92bd7296f54ff1e3659/poster.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/5df2b92bd7296f54ff1e3659/screenshot4_3.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/5df2b92bd7296f54ff1e3659/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5c5bf751f21b553c1f673ad6"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/5df2b92bd7296f54ff1e3659/poster16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Leigh Hoch"],"directors":["Michael Tauchert"],"writers":["Gisela Graichen"],"producers":["Peter Prestel Filmproduktion"],"originalReleaseDate":"2010-01-09T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/5df2b92bd7296f54ff1e3659/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"5fa97aacfd17cc001a00698a-uk":{"_id":"5fa97aacfd17cc001a00698a","seriesID":"5fa97aabfd17cc001a006984","slug":"stalins-daughter-2014-1-1","name":"Stalin's Daughter","summary":"The life of Stalin's daughter Svetlana in the bloody dictator's shadow. It is a Cold War sensation. Stalin's daughter Svetlana Alliluyeva flees to the USA, its capitalist archenemy.","description":"It is a sensation in the midst of the Cold War. Stalin's daughter Svetlana Alliluyeva flees to the West. During her childhood in the center of power, she was Joseph Stalin's favorite child. But death and violence overshadow her life. Her mother and brother die, relatives are killed, Stalin has her lover abducted. The Iron Curtain prevents her dream of family. She, like no other, jumps from one system to the other and loses herself in doing so. Svetlana Alliluyeva's desire for freedom makes her a plaything of power between communism and capitalism. This documentary shows Interviews with friends and family, exclusive photos and documents and especially Svetlana Alliluyeva’s final and never-before broadcast interview introduce us to the witness of a century. Stalin's daughter - a documentary about a legendary and unusual woman.","duration":3660000,"originalContentDuration":3120000,"allotment":3660,"rating":"12+","featuredImage":{"path":"https://images.pluto.tv/episodes/5fa97aacfd17cc001a00698a/screenshot16_9_1785965043096.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/5fa97aacfd17cc001a00698a/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/5fa97aacfd17cc001a00698a/poster_1785965043096.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/5fa97aacfd17cc001a00698a/screenshot4_3_1785965043096.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/5fa97aacfd17cc001a00698a/screenshot16_9_1785965043096.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5c5bf751f21b553c1f673ad6"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/5fa97aacfd17cc001a00698a/poster16_9_1785965043096.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Marfa Peshkova","Alexander Burdonsky","Olga Trifonova","Sergei Khrushchev","Martha Schad","Stepan Mikoyan","Grace Kennan","Rosa Shand"],"directors":["Jobst Knigge"],"writers":["Jobst Knigge"],"producers":["Jasmin Gravenhorst"],"originalReleaseDate":"2014-12-30T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/5fa97aacfd17cc001a00698a/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"5fa91cc4e5d584001a90dda4-uk":{"_id":"5fa91cc4e5d584001a90dda4","seriesID":"5fa91cc3e5d584001a90dd9c","slug":"operation-peter-pan-the-secret-war-against-cuba-2018-1-1","name":"Operation Peter Pan - The Secret War against Cuba","summary":"The documentary tells the story of unknown historical events of Cuban history and asks the question whether or not the US lead a secret war against their socialistic neighbour.","description":"In 2016, a historic moment arrived when Barack Obama spoke in Cuba to the inhabitants of the island nation and promised a future together. For the first time in more than 50 years, an American president had entered the communist country and turned towards an erstwhile enemy. However, the US economic embargo against Cuba continues. It sanctions the socialist state – although the UN General Assembly recently again called it a violation of international law. Many Cubans are therefore sceptical about a new political future, despite the friendly words of the American President. Their distrust is deep. It is based on over fifty years of history and the policies of the United States towards their country. For years, the Cuban government has raised serious allegations against their big neighbour. The film \"Operation Peter Pan\" tracks these allegations.","duration":3600000,"originalContentDuration":3090000,"allotment":3600,"rating":"9+","featuredImage":{"path":"https://images.pluto.tv/episodes/5fa91cc4e5d584001a90dda4/screenshot16_9_1765922772255.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/5fa91cc4e5d584001a90dda4/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/5fa91cc4e5d584001a90dda4/poster_1765922772255.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/5fa91cc4e5d584001a90dda4/screenshot4_3_1765922772255.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/5fa91cc4e5d584001a90dda4/screenshot16_9_1765922772255.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5c5bf751f21b553c1f673ad6"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"actors":["Marina Ochoa","Felix Rodriquez","Pedro J. Fuentes","Pedro Roig","Desmond Butler","William LeoGrande","Carmen Valdivia","María de los Ángeles Torres","José Buajasán Marrawi","René González"],"directors":["Norbert Busè"],"writers":["Norbert Busè"],"producers":["Milena Maitz"],"originalReleaseDate":"2018-12-30T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/5fa91cc4e5d584001a90dda4/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"5fa91ccde5d584001a90de52-uk":{"_id":"5fa91ccde5d584001a90de52","seriesID":"5fa91ccce5d584001a90de4c","slug":"nikita-khrushchev-the-red-tsar-2018-1-1","name":"Nikita Khrushchev - The Red Tsar","summary":"Khrushchev. A statesman and reformer who brought the world to the brink of catastrophe.","description":"Nikita Khrushchev’s (public) reckoning with the politics of Joseph Stalin created a political sensation. Is Nikita Khrushchev the true prophet of perestroika - or just the guardian of an inhuman system? Was he a great leader or just a bumbling peasant who stumbled into the top spot of the superpower’s hierarchy? At the time, the entire world was fascinated by this Russian. Khrushchev was an ardent Stalinist for many years yet it is he who managed to forever end the terror and persecutions of his predecessor. The Soviet head of state sought détente between the systems. But what remains is the memory of a shoe he banged on a table during the UN General Assembly. His professed goal was the peaceful coexistence of socialism and capitalism yet he drove the world to the edge of nuclear war during the Cuban Missile Crisis. Khrushchev ordered the freeing of the last German prisoners of war - and was also responsible for the building of the Wall. He was a reformer who was defeated by the system but - above all - also by himself. Stalin’s reign of terror, World War II, the de-Stalinization movement of the 50s, rapprochement but also the most serious crises of the Cold War - all this is closely associated with Nikita Khrushchev.","duration":3660000,"originalContentDuration":3120000,"allotment":3660,"rating":"9+","featuredImage":{"path":"https://images.pluto.tv/episodes/5fa91ccde5d584001a90de52/screenshot16_9_1765923848751.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/5fa91ccde5d584001a90de52/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/5fa91ccde5d584001a90de52/poster_1765923848752.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/5fa91ccde5d584001a90de52/screenshot4_3_1765923848752.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/5fa91ccde5d584001a90de52/screenshot16_9_1765923848751.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5c5bf751f21b553c1f673ad6"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"actors":["Nina Chruschtschowa","Sergej Chruschtschow","William Taubmann","Matthias Uhl"],"directors":["Jobst Knigge"],"writers":["Jobst Knigge"],"producers":["doc.station GmbH","ZDF","Jasmin Gravenhorst"],"originalReleaseDate":"2018-09-11T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/5fa91ccde5d584001a90de52/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"68d2ad81fa0f5ccff56f7af6-uk":{"_id":"68d2ad81fa0f5ccff56f7af6","seriesID":"68d2ad80fa0f5ccff56f7ad8","slug":"the-jewish-nazi-2025-1-1","name":"The Jewish Nazi?","summary":"The courageous story of a Jewish child who survived the Holocaust as the Nazi's youngest soldier, hiding his secret for years before finally discovering his true identity.","description":"The courageous story of a Jewish child who survived the Holocaust as the Nazi's youngest soldier, hiding his secret for years before finally discovering his true identity.","duration":6179000,"originalContentDuration":5219000,"allotment":6179,"rating":"15+","featuredImage":{"path":"https://images.pluto.tv/episodes/68d2ad81fa0f5ccff56f7af6/screenshot16_9_1758637447953.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Instructional & Educational","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/68d2ad81fa0f5ccff56f7af6/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/68d2ad81fa0f5ccff56f7af6/poster_1758637447080.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/68d2ad81fa0f5ccff56f7af6/screenshot4_3_1758637448708.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/68d2ad81fa0f5ccff56f7af6/screenshot16_9_1758637447953.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5c5bf751f21b553c1f673ad6"},{"id":"6422ca02a3ade70008f4e826"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/68d2ad81fa0f5ccff56f7af6/poster16_9_1758637449515.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"originalReleaseDate":"2025-01-26T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/68d2ad81fa0f5ccff56f7af6/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"5fa91ccce5d584001a90de3b-uk":{"_id":"5fa91ccce5d584001a90de3b","seriesID":"5fa91ccbe5d584001a90de35","slug":"mata-hari-the-beautiful-spy-2018-1-1","name":"Mata Hari - The Beautiful Spy","summary":"Mata Hari. Dance, Seduction and Espionage. The enduring myth.","description":"In February 1917 World War I is raging when Mata Hari is arrested in Paris and taken to the examining magistrate. Her very life is at stake: she is accused of high treason. The famous exotic dancer has come to represent beauty and the power of feminine seduction. The documentary Mata Hari - the Beautiful Spy tracks down the true story of this fascinating woman. The exotic dancer and spy is born Margaretha Zelle in the Netherlands. She lives in the Dutch East Indies with her husband, an Army officer, and the torments she experiences there are now revealed for the first time. In Paris at the dawn of the 20th century Margaretha transforms herself into Mata Hari, a superstar. Her dances are exotic, erotic - and very sexy. As a courtesan she captivates the most influential men of her time. But when World War I breaks out the dancer becomes embroiled in a network of espionage. She accepts payment from Germany and France, and she is placed under surveillance by the British. Mata Hari travels around Europe ... and fails to realise that the terrible war is ensnaring her too. The beautiful seductress becomes a victim of politics, of ambitious men and also of her own arrogance. Who is this woman, who exerts a hold over our imagination to this very day? Did Mata Hari really betray secrets revealed to her by influential lovers in moments of weakness? Were her accusers right? Mata Hari is sentenced to death for espionage and hanged in October 1917. But only afterwards does she celebrate her real triumph. The star is transformed into a myth: the most famous and most beautiful spy all time.","duration":3660000,"originalContentDuration":3120000,"allotment":3660,"rating":"9+","featuredImage":{"path":"https://images.pluto.tv/episodes/5fa91ccce5d584001a90de3b/screenshot16_9_1787081401938.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/5fa91ccce5d584001a90de3b/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/5fa91ccce5d584001a90de3b/poster_1787081401938.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/5fa91ccce5d584001a90de3b/screenshot4_3_1787081401938.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/5fa91ccce5d584001a90de3b/screenshot16_9_1787081401938.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5c5bf751f21b553c1f673ad6"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"actors":["Nick Benjamin","Philippe Collas","Hanneke Boonstra","Julie Wheelwright","Jean Pierre Turbergue","Yves Rocourt"],"directors":["Jobst Knigge"],"writers":["Jobst Knigge","Kristina Forbat"],"producers":["Jasmin Gravenhorst"],"originalReleaseDate":"2018-03-04T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/5fa91ccce5d584001a90de3b/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"5df2b977d7296f54ff1e36d3-uk":{"_id":"5df2b977d7296f54ff1e36d3","seriesID":"5df2b932d7296f54ff1e36c1","slug":"lost-treasures-of-the-silk-road-2013-1-1","name":"Lost Treasures of the Silk Road","summary":"Lost Treasures of the Silk Road reveals amazing insights from experts worldwide, which could rewrite the history of the relations between East and West.","description":"Lost Treasures of the Silk Road reveals amazing insights from experts worldwide, which could rewrite the history of the relations between East and West.","duration":3600000,"originalContentDuration":3060000,"allotment":3600,"rating":"9+","featuredImage":{"path":"https://images.pluto.tv/episodes/5df2b977d7296f54ff1e36d3/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/5df2b977d7296f54ff1e36d3/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/5df2b977d7296f54ff1e36d3/poster.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/5df2b977d7296f54ff1e36d3/screenshot4_3.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/5df2b977d7296f54ff1e36d3/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5c5bf751f21b553c1f673ad6"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/5df2b977d7296f54ff1e36d3/poster16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"directors":["Susanne RostoskyPeter Pippig"],"writers":["Uwe KräuterSusanne Rostosky"],"producers":["Jens Afflerbach"],"originalReleaseDate":"2013-10-19T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/5df2b977d7296f54ff1e36d3/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"5fa91cd0e5d584001a90de80-uk":{"_id":"5fa91cd0e5d584001a90de80","seriesID":"5fa91ccfe5d584001a90de7a","slug":"hitlers-mega-plane-2017-1-1","name":"Hitler's Mega Plane","summary":"In January 2012 Italian divers discovered the wreck of a massive plane off the coast of Sardinia. At a depth of 65 meters (213 feet) lies a Messerschmidt “Gigant”.","description":"In January 2012, Italian divers discovered the wreck of a massive plane off the coast of Sardinia. At a depth of 65 meters (213 feet) lies a Messerschmidt “Gigant”, the biggest aircraft in WWII. The finding is a sensation. None of Hitler’s mega planes has survived the war, and no other wreck has ever been found. 70 years after the disaster the film takes us on a thrilling search for traces and the fate of the wreck and its victims. One of them is Arthur Busch. Only through the making of the film, his daughter Herta Salzmann, today living in the United States, learns the true faith of her father.","duration":3540000,"originalContentDuration":3030000,"allotment":3540,"rating":"9+","featuredImage":{"path":"https://images.pluto.tv/episodes/5fa91cd0e5d584001a90de80/screenshot16_9_1778874846175.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"War","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/5fa91cd0e5d584001a90de80/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/5fa91cd0e5d584001a90de80/poster_1778874846175.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/5fa91cd0e5d584001a90de80/screenshot4_3_1778874846175.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/5fa91cd0e5d584001a90de80/screenshot16_9_1778874846175.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5c5bf751f21b553c1f673ad6"},{"id":"6422ca02a3ade70008f4e826"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/5fa91cd0e5d584001a90de80/poster16_9_1778874846175.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["David Kehoe"],"directors":["Thomas Staehler","Oliver Halmburger"],"writers":["Thomas Staehler","Oliver Halmburger"],"producers":["Oliver Halmburger","Thomas Staehler"],"originalReleaseDate":"2017-04-20T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/5fa91cd0e5d584001a90de80/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"626f85e673a0a1001450ab95-uk":{"_id":"626f85e673a0a1001450ab95","seriesID":"626f85e473a0a1001450ab8e","slug":"casanova-the-art-of-seduction-2013-1-1","name":"Casanova - the Art of Seduction","summary":"Giacomo Casanova was born in Venice in 1725, to poor parents. Initially, he is expected to become a priest, but he is ultimately going to reject this career path.","description":"Giacomo Casanova was born in Venice in 1725, to poor parents. Initially, he is expected to become a priest, but he is ultimately going to reject this career path. His destiny is governed by the love of women, and he challenges the most powerful institutions of his time: the Catholic Church and the Venetian Inquisition. For Casanova, life in decadent Venice is an on-going feast for the senses – until he is jailed for one and a half years in the notorious leads (piombi). With his spectacular escape from what was known to be the safest prison during his time, he becomes a legend. The power of his charms is a mystery to many. He converses with the great minds of his age and exchanges philosophical ideas with them. Madame de Pompadour and Frederic the Great are among the influential people on whom he leaves a lasting impression. Several times, he wins and loses a fortune in gambling. He converses with the Pope in Rome, establishes the first French lottery in Paris and makes a fortune. Enormous debt eventually causes him to flee London and Madrid, where he is threatened to be executed. He translates Homer’s Iliad and contributes to the libretto of Don Giovanni, Mozart’s opera. He survives several duels and works for the Venetian secret service. In the figure of Casanova, the entire 18th century comes alive. At the heart of his thought and action, there is always the love of women and the pursuit of happiness. His memoirs are quite likely the most sincere and erotically frank life report that has ever been written in the history of mankind. Perhaps this is why, even 200 years after his death, Casanova, the libertine, feels like a modern to us. With his uninhibited sensuality and sexual conduct, Casanova redefines the relationship between men and women beyond religion and convention in an almost revolutionary way. The film is a portrait of the man who became a myth. Adrian Becker plays Giacomo Casanova.","duration":3000000,"originalContentDuration":2625000,"allotment":3000,"rating":"12+","featuredImage":{"path":"https://images.pluto.tv/episodes/626f85e673a0a1001450ab95/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Documentary","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/626f85e673a0a1001450ab95/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/626f85e673a0a1001450ab95/poster.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/626f85e673a0a1001450ab95/screenshot4_3.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/626f85e673a0a1001450ab95/screenshot16_9.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5c5bf751f21b553c1f673ad6"}],"poster16_9":{"path":"https://images.pluto.tv/assets/images/default/vod.screenshot16_9-default.jpg"},"clip":{"actors":["Adrian Becker"],"directors":["Eike Schmitz"],"writers":["Eike Schmitz"],"producers":["Eike Schmitz"],"originalReleaseDate":"2013-04-20T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/626f85e673a0a1001450ab95/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"666feb9ac3f49b0013c21fdb-uk":{"_id":"666feb9ac3f49b0013c21fdb","seriesID":"666feb98c3f49b0013c21fb9","slug":"the-titanic-inquiry-2012-1-1","name":"The Titanic Inquiry","summary":"The true story of the official Inquiry into the Titanic disaster. Was a ship called The Californian cl