88,"rating":"15+","featuredImage":{"path":"https://images.pluto.tv/episodes/6a44cd47920a04f6d72a1968/screenshot16_9_1782893896371.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Comedy","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6a44cd47920a04f6d72a1968/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6a44cd47920a04f6d72a1968/poster_1782893896371.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6a44cd47920a04f6d72a1968/screenshot4_3_1782893896371.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6a44cd47920a04f6d72a1968/screenshot16_9_1782893896371.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5bc7591f62ba3220efe57cef"},{"id":"5ef87fe29af6550007434708"},{"id":"5ef87f1b8c4ce900075d5ad9"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6a44cd47920a04f6d72a1968/poster16_9_1782893896371.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Steve Evets","Eric Cantona","John Henshaw","Stephanie Bishop","Gerard Kearns","Stefan Gumbs","Lucy-Jo Hudson","Cole Williams","Dylan Williams","Matthew McNulty"],"directors":["Ken Loach"],"producers":["Rebecca O'Brien"],"originalReleaseDate":"2009-05-05T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6a44cd47920a04f6d72a1968/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"6a44d009925ff998a6f65c63-uk":{"_id":"6a44d009925ff998a6f65c63","seriesID":"6a44d008925ff998a6f65c44","slug":"sound-of-freedom-2023-1-1","name":"Sound Of Freedom","summary":"In this global box office sensation, an ex-federal agent embarks on a dangerous journey to rescue a victim of child trafficking from a terrible fate.","description":"The global box office sensation, based on an incredible true story, this gripping drama packed with tension shines a light on even the darkest of places. After rescuing a young boy from ruthless child traffickers, a federal agent learns that the boy's sister is still captive and decides to embark on a dangerous mission to save her. With time running out, he quits his job and journeys deep into the Colombian jungle, putting his life on the line to free her from a fate worse than death. Starring Jim Caviezel (The Passion of the Christ, The Thin Red Line), Academy Award winner Mira Sorvino (Mighty Aphrodite, The Replacement Killers), and Emmy nominee Bill Camp (12 Years a Slave, The Killing of a Sacred Deer).","duration":9312000,"originalContentDuration":7872000,"allotment":9312,"rating":"15+","featuredImage":{"path":"https://images.pluto.tv/episodes/6a44d009925ff998a6f65c63/screenshot16_9_1782894602527.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"genre":"Drama","type":"movie","seasonsNumbers":[],"stitched":{"path":"/stitch/hls/episode/6a44d009925ff998a6f65c63/master.m3u8"},"covers":[{"aspectRatio":"347:500","url":"https://images.pluto.tv/episodes/6a44d009925ff998a6f65c63/poster_1782894602527.jpg?fill=blur&fit=fill&fm=jpg&h=1000&q=75&w=694"},{"aspectRatio":"4:3","url":"https://images.pluto.tv/episodes/6a44d009925ff998a6f65c63/screenshot4_3_1782894602527.jpg?fill=blur&fit=fill&fm=jpg&h=480&q=75&w=640"},{"aspectRatio":"16:9","url":"https://images.pluto.tv/episodes/6a44d009925ff998a6f65c63/screenshot16_9_1782894602527.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"}],"categories":[{"id":"5bc7591f62ba3220efe57cef"},{"id":"5e4eaa52176dab00097079d7"},{"id":"5ef87f1b8c4ce900075d5ad9"}],"poster16_9":{"path":"https://images.pluto.tv/episodes/6a44d009925ff998a6f65c63/poster16_9_1782894602527.jpg?fill=blur&fit=fill&fm=jpg&h=540&q=75&w=960"},"clip":{"actors":["Jim Caviezel","Mira Sorvino","Bill Camp"],"directors":["Alejandro Monteverde"],"producers":["Dave Adams"],"originalReleaseDate":"2023-12-25T00:00:00Z"},"avail":{},"stream_url":"https://cfd-v4-service-channel-stitcher-use1-1.prd.pluto.tv/v2/stitch/hls/episode/6a44d009925ff998a6f65c63/master.m3u8?advertisingId=&appName=web&appVersion=7.9.0-a9cca6b89aea4dc0998b92a51989d2adb9a9025d&app_name=web&clientDeviceType=0&clientID=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&clientModelNumber=1.0.0&country=GB&deviceDNT=false&deviceId=688e2fcf-3b1e-4478-a146-7d2b26ed9b90&deviceLat=51.5100&deviceLon=-0.0800&deviceMake=Chrome&deviceModel=web&deviceType=web&deviceVersion=16.2.0&marketingRegion=GB&serverSideAds=true&sessionID=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&sid=04ec44b2-d506-11f1-9e7f-2af1ca94ebdb&userId=&jwt=eyJhbGciOiJIUzI1NiIsImtpZCI6IjU3MGE4NTE5LTNhNzEtNGQ1Ni1iMTAyLTIwN2Q4MjI4MTZkYiIsInR5cCI6IkpXVCJ9..12EU-uv7NlsyswTGY3ySL8nLtjjLm4qOFCmlC5Bnkno&masterJWTPassthrough=true"},"6a44d2e3b8b3ee5ada2a0960-uk":{"_id":"6a44d2e3b8b3ee5ada2a0960","seriesID":"6a44d2e2b8b3ee5ada2a0943","slug":"the-curse-of-frankenstein-1956-1-1","name":"The Curse Of Frankenstein","summary":"When Victor Frankenstein brings a dead animal back to life through the power of science, he decides to build the perfect human being from body parts!","description":"The Curse of Frankenstein returns, directed by Terence Fisher and starring the legendary duo of Peter Cushing as Baron Frankenstein and Christopher Lee as the Creature, performing together for the very first time! Experience Hammer's first colour horror, which rede